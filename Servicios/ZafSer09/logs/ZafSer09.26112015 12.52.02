 select co_emp, co_tra, empleado ,sum(sobretiempo) as sobretiempo from (  select co_emp, co_tra, empleado ,sum(valorSobretiempo) as sobretiempo  from (  select c.co_emp, a.co_loc, a.co_tipdoc, a.co_doc, a.fe_doc, a.co_dep, c.co_hor ,a.fe_sol, a.ho_autdes, a.ho_authas, a.fe_aut, c.co_tra,  (d.tx_ape || ' ' || d.tx_nom) as empleado, e.fe_dia, e.ho_ent, e.ho_sal,  g.tx_tiphorpag as st_tipsob,  g.ho_des as hordessob,g.ho_has as horhassob,  nd_porpag as porpagar, nd_valrub as sueldo, (((nd_valrub/30)/8)/60) as valPerMin,  (ho_authas-ho_autdes) as sobretiempoautorizado,  (e.ho_sal-ho_autdes) as sobretiempoempleado,  case ((e.ho_sal-ho_autdes)<(ho_authas-ho_autdes)) when true then (e.ho_sal-ho_autdes) else (ho_authas-ho_autdes) end as sobretiempo,  (  extract(hours from (case when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)<(e.ho_ent)) then (ho_authas-e.ho_ent) 			   when ((ho_authas)>(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (e.ho_sal-ho_autdes) 		                           when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (ho_authas-ho_autdes)                            else (e.ho_sal-ho_autdes) end)  )*60,  extract(minutes from (case when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)<(e.ho_ent)) then (ho_authas-e.ho_ent) 			   when ((ho_authas)>(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (e.ho_sal-ho_autdes)                          when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (ho_authas-ho_autdes)                          else (e.ho_sal-ho_autdes) end)  ),  extract(seconds from (case when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)<(e.ho_ent)) then (ho_authas-e.ho_ent) 		   when ((ho_authas)>(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (e.ho_sal-ho_autdes)                when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (ho_authas-ho_autdes)                else (e.ho_sal-ho_autdes) end)  )/60  ) as matrinf,  (  extract(hours from (case when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)<(e.ho_ent)) then (ho_authas-e.ho_ent) 		   when ((ho_authas)>(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (e.ho_sal-ho_autdes)                when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (ho_authas-ho_autdes)                else (e.ho_sal-ho_autdes) end)  )*60 +  extract(minutes from (case when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)<(e.ho_ent)) then (ho_authas-e.ho_ent) 		   when ((ho_authas)>(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (e.ho_sal-ho_autdes)                when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (ho_authas-ho_autdes)                else (e.ho_sal-ho_autdes) end)  )+  (extract(seconds from (case when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)<(e.ho_ent)) then (ho_authas-e.ho_ent) 		   when ((ho_authas)>(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (e.ho_sal-ho_autdes)                when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (ho_authas-ho_autdes)                else (e.ho_sal-ho_autdes) end)  )/60)  )as matrinfsum,  (  (extract(hours from (case when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)<(e.ho_ent)) then (ho_authas-e.ho_ent) 		   when ((ho_authas)>(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (e.ho_sal-ho_autdes)                when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (ho_authas-ho_autdes)                else (e.ho_sal-ho_autdes) end)  )*60) +  (extract(minutes from (case when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)<(e.ho_ent)) then (ho_authas-e.ho_ent) 		   when ((ho_authas)>(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (e.ho_sal-ho_autdes)                 when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (ho_authas-ho_autdes)                 else (e.ho_sal-ho_autdes) end)  ))+  (extract(seconds from (case when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)<(e.ho_ent)) then (ho_authas-e.ho_ent) 		   when ((ho_authas)>(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (e.ho_sal-ho_autdes)                 when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (ho_authas-ho_autdes)                 else (e.ho_sal-ho_autdes) end)  )/60)  ) * ( ((((nd_valrub/30)/8)/60) * ((nd_porpag+100)/100)) ) as valorSobretiempo  FROM ( SELECT co_emp, co_loc, co_tipdoc, co_doc, fe_doc, co_dep, fe_sol, st_aut, ho_authas, st_reg, fe_aut, ho_autdes FROM tbm_cabSolHorSupExt WHERE (ho_autDes>'00:00' AND ho_autHas<'06:00') OR (ho_autDes>='06:00' AND ho_autHas<='24:00') AND st_reg='A' UNION ALL SELECT co_emp, co_loc, co_tipdoc, co_doc, fe_doc, co_dep, fe_sol, st_aut, '06:00' AS ho_authas, st_reg, fe_aut, ho_autdes FROM tbm_cabSolHorSupExt WHERE (ho_autDes<'06:00' AND ho_autHas>'06:00') AND st_reg='A' UNION ALL SELECT co_emp, co_loc, co_tipdoc, co_doc, fe_doc, co_dep, fe_sol, st_aut, ho_authas, st_reg, fe_aut, CAST('06:00' AS TIME) AS ho_autdes FROM tbm_cabSolHorSupExt WHERE (ho_autDes<'06:00' AND ho_autHas>'06:00') AND st_reg='A' ) AS a inner join tbm_detsolhorsupext b on (a.co_emp=b.co_emp and a.co_loc=b.co_loc and a.co_tipdoc=b.co_tipdoc and a.co_doc=b.co_doc) inner join tbm_traemp c on (b.co_emppag=c.co_emp and b.co_tra=c.co_tra) inner join tbm_tra d on (c.co_tra=d.co_tra) left outer join tbm_cabconasitra e on (e.co_tra=d.co_tra and e.fe_dia=a.fe_sol) inner join tbm_callab f on (e.fe_dia=f.fe_dia and f.co_hor=c.co_hor) inner join tbm_porPagHorSupExt g on (g.tx_tiphorpag in ( case (extract(DOW from e.fe_dia) in (1,2,3,4,5) and f.st_dialab='S' and (a.ho_autdes between ho_des and ho_has) and (a.ho_authas between ho_des and ho_has) ) when true then 'S' else 'E' end)) inner join tbm_suetra h on (h.co_tra=c.co_tra and h.co_emp=c.co_emp and h.co_rub=1) inner join tbm_dethortra i on(c.co_hor=i.co_hor and i.ne_dia in(extract(dow from e.fe_dia))) where date(fe_aut) between (select fe_des from tbm_feccorrolpag where co_emp=1 and ne_ani=2015 and ne_mes=11 and ne_per=1)
 and (select fe_has from tbm_feccorrolpag where co_emp=1 and ne_ani=2015 and ne_mes=11 and ne_per=2)
 and  b.co_tra not in (90 , 65 , 253)  and (e.ho_ent is not null and e.ho_sal is not null)  and a.st_reg='A'  and a.st_aut='T'  and (  extract(hours from (case when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)<(e.ho_ent)) then (ho_authas-e.ho_ent) 					   when ((ho_authas)>(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (e.ho_sal-ho_autdes)                when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (ho_authas-ho_autdes)                else (e.ho_sal-ho_autdes) end)  )*60 +  extract(minutes from (case when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)<(e.ho_ent)) then (ho_authas-e.ho_ent) 		   when ((ho_authas)>(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (e.ho_sal-ho_autdes)                when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (ho_authas-ho_autdes)                else (e.ho_sal-ho_autdes) end)  )+  (extract(seconds from (case when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)<(e.ho_ent)) then (ho_authas-e.ho_ent) 		   when ((ho_authas)>(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (e.ho_sal-ho_autdes)                when ((ho_authas)<(e.ho_sal)) and ((ho_autdes)>(e.ho_ent)) then (ho_authas-ho_autdes)                else (e.ho_sal-ho_autdes) end)  )/60)  )>0  order by a.co_doc  )xsob  group by xsob.co_emp, xsob.co_tra, xsob.empleado  union  select co_emp, co_tra, empleado, sum(valorSobretiempo) as sobretiempo from (  select a.co_emp,b.co_tra,(d.tx_ape || ' ' || d.tx_nom) as empleado ,b.co_rub,tx_tipegrprg,sum(nd_valcuo) as valorSobretiempo, b.fe_ing from tbm_detingegrprgtra a  inner join tbm_cabingegrprgtra b on (a.co_emp=b.co_emp and a.co_egr=b.co_egr)  inner join tbm_rubrolpag c on (b.co_rub=c.co_rub and tx_tiprub='I')  inner join tbm_tra d on (d.co_tra=b.co_tra)  where EXTRACT(YEAR FROM fe_cuo) = 2015
 and EXTRACT(MONTH FROM fe_cuo) = 11
 and tx_tipegrprg like 'D' and b.st_reg like 'A'  and date(b.fe_ing)  BETWEEN (select fe_des as fe_des from tbm_feccorrolpag  where co_emp=b.co_emp  and ne_ani = 2015
 and ne_mes = 11
 and ne_per=1) and (select fe_has as fe_des from tbm_feccorrolpag  where co_emp=b.co_emp  and ne_ani = 2015
 and ne_mes = 11
 and ne_per=2)  and b.co_rub in (3)  group by a.co_emp,b.co_tra,empleado,b.co_rub,tx_tipegrprg, b.fe_ing)xvaldefhe2  group by xvaldefhe2.co_emp, xvaldefhe2.co_tra,xvaldefhe2.empleado  )xvaldefhe2Sum  group by xvaldefhe2Sum.co_emp,xvaldefhe2Sum.co_tra,xvaldefhe2Sum.empleado 
