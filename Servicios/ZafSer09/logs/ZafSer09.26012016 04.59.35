SELECT distinct a.co_tra,b.tx_nom,b.tx_ape, fe_inicon, Tx_ForPagDecTerSue, Tx_ForPagDecCuaSue,  case ( (EXTRACT (MONTH FROM fe_inicon)=1) AND (EXTRACT (YEAR FROM fe_inicon)=2016) ) when true then true else false end as blnIsTraNew FROM tbm_traemp a inner join tbm_tra b on (a.co_tra=b.co_tra) WHERE a.st_reg like 'A' and co_emp = 1 and (a.Tx_ForPagDecTerSue= 'M' or   a.Tx_ForPagDecCuaSue='M' ) order by a.co_tra
SELECT distinct a.co_tra,b.tx_nom,b.tx_ape, fe_inicon, Tx_ForPagDecTerSue, Tx_ForPagDecCuaSue,  case ( (EXTRACT (MONTH FROM fe_inicon)=1) AND (EXTRACT (YEAR FROM fe_inicon)=2016) ) when true then true else false end as blnIsTraNew FROM tbm_traemp a inner join tbm_tra b on (a.co_tra=b.co_tra) WHERE a.st_reg like 'A' and co_emp = 2 and (a.Tx_ForPagDecTerSue= 'M' or   a.Tx_ForPagDecCuaSue='M' ) order by a.co_tra
SELECT distinct a.co_tra,b.tx_nom,b.tx_ape, fe_inicon, Tx_ForPagDecTerSue, Tx_ForPagDecCuaSue,  case ( (EXTRACT (MONTH FROM fe_inicon)=1) AND (EXTRACT (YEAR FROM fe_inicon)=2016) ) when true then true else false end as blnIsTraNew FROM tbm_traemp a inner join tbm_tra b on (a.co_tra=b.co_tra) WHERE a.st_reg like 'A' and co_emp = 4 and (a.Tx_ForPagDecTerSue= 'M' or   a.Tx_ForPagDecCuaSue='M' ) order by a.co_tra
