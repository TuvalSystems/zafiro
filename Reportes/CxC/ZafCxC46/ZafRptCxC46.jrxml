	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="codEmp" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="codLoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="codTipDoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="codDoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="nomUsr" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select emp.tx_nom as nomemp, current_timestamp as fecimp, a4.tx_descor, a.ne_numdoc1, a.fe_doc, a.nd_mondoc,
a3.tx_nomcli, a3.ne_numdoc, abs(a2.mo_pag) as valdoc, a1.nd_abo
, a.tx_obs1
from tbm_cabpag as a
inner join tbm_detpag as a1 on (a1.co_emp=a.co_emp and a1.co_loc=a.co_loc and a1.co_tipdoc=a.co_tipdoc and a1.co_doc=a.co_doc)
inner join tbm_pagmovinv as a2 on (a2.co_emp=a1.co_emp and a2.co_loc=a1.co_locpag and a2.co_tipdoc=a1.co_tipdocpag and a2.co_doc=a1.co_docpag and a2.co_reg=a1.co_regpag )
inner join tbm_cabmovinv as a3 on (a3.co_emp=a2.co_emp and a3.co_loc=a2.co_loc and a3.co_tipdoc=a2.co_tipdoc and a3.co_doc=a2.co_doc )
inner join tbm_cabtipdoc as a4 on (a4.co_emp=a.co_emp and a4.co_loc=a.co_loc and a4.co_tipdoc=a.co_tipdoc )
left join tbm_emp as emp on (emp.co_emp=a.co_emp)
where a.co_emp= $P{codEmp}
and a.co_loc= $P{codLoc}
and a.co_tipdoc= $P{codTipDoc}
and a.co_doc= $P{codDoc}
order by a1.co_reg]]>
	</queryString>
