<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafRptCxC24" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="titulo" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\Zafiro_escritorio\\Reportes\\CxC\\ZafCxC24\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="co_emp" class="java.lang.Integer"/>
	<parameter name="co_loc" class="java.lang.Integer"/>
	<parameter name="co_tipdoc" class="java.lang.Integer"/>
	<parameter name="co_doc" class="java.lang.Integer"/>
	<parameter name="strCamAudRpt" class="java.lang.String"/>
	<parameter name="nomemp" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a.co_emp, a.co_loc, a.co_tipdoc, a.co_doc,  a.co_cli, a.tx_nomcli, a1.tx_descor, a1.tx_deslar
,a.fe_doc, a.ne_numdoc1, a.nd_mondoc
from tbm_cabpag as a
inner join tbm_cabtipdoc as a1 on (a1.co_emp=a.co_emp and a1.co_loc=a.co_loc and a1.co_tipdoc=a.co_tipdoc )
where a.co_emp=$P{co_emp}
and a.co_loc=$P{co_loc}
and a.co_tipdoc=$P{co_tipdoc}
and a.co_doc= $P{co_doc}]]>
	</queryString>
	<field name="co_emp" class="java.lang.Integer"/>
	<field name="co_loc" class="java.lang.Integer"/>
	<field name="co_tipdoc" class="java.lang.Integer"/>
	<field name="co_doc" class="java.lang.Integer"/>
	<field name="co_cli" class="java.lang.Integer"/>
	<field name="tx_nomcli" class="java.lang.String"/>
	<field name="tx_descor" class="java.lang.String"/>
	<field name="tx_deslar" class="java.lang.String"/>
	<field name="fe_doc" class="java.sql.Date"/>
	<field name="ne_numdoc1" class="java.lang.Integer"/>
	<field name="nd_mondoc" class="java.math.BigDecimal"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="42" splitType="Stretch">
			<textField>
				<reportElement x="100" y="18" width="297" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="14" isUnderline="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{titulo}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="2" y="2" width="150" height="15"/>
				<textElement>
					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{nomemp}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<pageHeader>
		<band height="75" splitType="Stretch">
			<staticText>
				<reportElement x="4" y="6" width="90" height="20"/>
				<textElement/>
				<text><![CDATA[Tipo documento:]]></text>
			</staticText>
			<staticText>
				<reportElement x="407" y="6" width="56" height="20"/>
				<textElement/>
				<text><![CDATA[Fecha:]]></text>
			</staticText>
			<staticText>
				<reportElement x="407" y="26" width="56" height="20"/>
				<textElement/>
				<text><![CDATA[Num.Doc:]]></text>
			</staticText>
			<textField>
				<reportElement x="95" y="6" width="56" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{tx_descor}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="152" y="6" width="245" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{tx_deslar}]]></textFieldExpression>
			</textField>
			<textField pattern="MM/dd/yyyy">
				<reportElement x="465" y="6" width="79" height="20"/>
				<textElement/>
				<textFieldExpression class="java.util.Date"><![CDATA[$F{fe_doc}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="465" y="26" width="79" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{ne_numdoc1}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="409" y="46" width="56" height="20"/>
				<textElement/>
				<text><![CDATA[MomDoc:]]></text>
			</staticText>
			<textField pattern="###0.00;(-###0.00)">
				<reportElement x="465" y="50" width="79" height="15"/>
				<textElement/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{nd_mondoc}]]></textFieldExpression>
			</textField>
		</band>
	</pageHeader>
	<columnHeader>
		<band height="2" splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="42" splitType="Stretch">
			<subreport>
				<reportElement x="3" y="2" width="206" height="16"/>
				<subreportParameter name="co_emp">
					<subreportParameterExpression><![CDATA[$F{co_emp}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="co_loc">
					<subreportParameterExpression><![CDATA[$F{co_loc}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="co_tipdoc">
					<subreportParameterExpression><![CDATA[$F{co_tipdoc}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="co_doc">
					<subreportParameterExpression><![CDATA[$F{co_doc}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{SUBREPORT_DIR} + "ZafSubRptCxC06_01.jasper"]]></subreportExpression>
			</subreport>
		</band>
		<band height="42">
			<subreport>
				<reportElement x="3" y="3" width="206" height="19"/>
				<subreportParameter name="co_emp">
					<subreportParameterExpression><![CDATA[$F{co_emp}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="co_loc">
					<subreportParameterExpression><![CDATA[$F{co_loc}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="co_tipdoc">
					<subreportParameterExpression><![CDATA[$F{co_tipdoc}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="co_doc">
					<subreportParameterExpression><![CDATA[$F{co_doc}]]></subreportParameterExpression>
				</subreportParameter>
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<subreportExpression class="java.lang.String"><![CDATA[$P{SUBREPORT_DIR} + "ZafSubRptCxC06_02.jasper"]]></subreportExpression>
			</subreport>
		</band>
	</detail>
	<columnFooter>
		<band height="30" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement key="textField" x="10" y="14" width="512" height="12"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{strCamAudRpt}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement key="line-1" x="10" y="10" width="512" height="1" isRemoveLineWhenBlank="true">
					<printWhenExpression><![CDATA[!$P{strCamAudRpt}.equals("")]]></printWhenExpression>
				</reportElement>
			</line>
		</band>
	</columnFooter>
	<pageFooter>
		<band height="5" splitType="Stretch"/>
	</pageFooter>
	<summary>
		<band height="4" splitType="Stretch"/>
	</summary>
</jasperReport>
