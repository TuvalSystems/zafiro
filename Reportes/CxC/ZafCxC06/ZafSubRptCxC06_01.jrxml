<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafSubRptCxC06_01" language="groovy" pageWidth="595" pageHeight="842" columnWidth="581" leftMargin="0" rightMargin="14" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="3.0"/>
	<property name="ireport.x" value="1095"/>
	<property name="ireport.y" value="0"/>
	<parameter name="co_emp" class="java.lang.Integer"/>
	<parameter name="co_loc" class="java.lang.Integer"/>
	<parameter name="co_tipdoc" class="java.lang.Integer"/>
	<parameter name="co_doc" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select a2.co_cli, a2.tx_nomcli, a2.co_loc, a3.tx_descor, a2.ne_numdoc,  a2.fe_doc, a1.ne_diacre, a1.fe_ven, a1.nd_porret, a1.mo_pag, (a1.mo_pag+a1.nd_abo) as valpen, abs(a.nd_abo) as nd_abo
from tbm_detpag as a
inner join tbm_pagmovinv as a1 on (a1.co_emp=a.co_emp and a1.co_loc=a.co_locpag and a1.co_tipdoc=a.co_tipdocpag and a1.co_doc=a.co_docpag and a1.co_reg=a.co_regpag )
inner join tbm_cabmovinv as a2 on (a2.co_emp=a1.co_emp and a2.co_loc=a1.co_loc and a2.co_tipdoc=a1.co_tipdoc and a2.co_doc=a1.co_doc )
inner join tbm_cabtipdoc as a3 on (a3.co_emp=a2.co_emp and a3.co_loc=a2.co_loc and a3.co_tipdoc=a2.co_tipdoc )
where a.co_emp=$P{co_emp}
and a.co_loc=$P{co_loc}
and a.co_tipdoc=$P{co_tipdoc}
and a.co_doc= $P{co_doc}
and a.nd_abo < 0
]]>
	</queryString>
	<field name="co_cli" class="java.lang.Integer"/>
	<field name="tx_nomcli" class="java.lang.String"/>
	<field name="co_loc" class="java.lang.Integer"/>
	<field name="tx_descor" class="java.lang.String"/>
	<field name="ne_numdoc" class="java.lang.Integer"/>
	<field name="fe_doc" class="java.sql.Date"/>
	<field name="ne_diacre" class="java.lang.Integer"/>
	<field name="fe_ven" class="java.sql.Date"/>
	<field name="nd_porret" class="java.math.BigDecimal"/>
	<field name="mo_pag" class="java.math.BigDecimal"/>
	<field name="valpen" class="java.math.BigDecimal"/>
	<field name="nd_abo" class="java.math.BigDecimal"/>
