	<queryString>
		<![CDATA[select a2.tx_descor, a3.ne_numdoc1, a3.fe_doc,a3.nd_mondoc,a1.co_tipdocrel,a1.co_docrel
 from tbm_detCieCobTarCre As a1
 inner join tbm_cabtipdoc as a2 on (a1.co_emp=a2.co_emp and a1.co_loc=a2.co_loc and a1.co_tipdocrel=a2.co_tipdoc)
 inner join tbm_cabpag as a3 on (a1.co_emp=a3.co_emp and a1.co_loc=a3.co_loc and a1.co_tipdocrel=a3.co_tipdoc and a1.co_docrel = a3.co_doc)
 WHERE a1.co_emp=$P{co_emp} and a1.co_loc=$P{co_loc}  and
     a1.co_tipdoc=$P{co_tipdoc}  and a1.co_doc=$P{co_doc}    ORDER BY a1.co_reg]]>
	</queryString>
	<field name="tx_descor" class="java.lang.String"/>
	<field name="ne_numdoc1" class="java.lang.Integer"/>
	<field name="fe_doc" class="java.sql.Date"/>
