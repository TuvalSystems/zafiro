	<parameter name="codEmp" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="codLoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="codTipDoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="codDoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="nomUsr" class="java.lang.String" isForPrompting="false"/>
	<parameter name="titRpt" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[select  usr.tx_nom as nomusring, current_timestamp as fecimp,  a.ne_numdoc1, a2.tx_nom as nomrec, a.fe_doc, a.nd_mondoc, a1.co_cli, a3.tx_nom as nomcli, a4.tx_descor, a4.tx_deslar, a1.tx_numctachq, a1.tx_numchq, a1.nd_monchq , a1.fe_venchq
, a1.st_asidocrel
from tbm_cabrecdoc as a
inner join tbm_detrecdoc as a1 on (a1.co_emp=a.co_emp and a1.co_loc=a.co_loc and a1.co_tipdoc=a.co_tipdoc and a1.co_doc=a.co_doc )
left join tbm_usr as a2 on (a2.co_usr=a.co_usrrec )
left join tbm_cli as a3 on (a3.co_emp=a1.co_emp and a3.co_cli=a1.co_cli )
left join tbm_var as a4 on (a4.co_reg=a1.co_banchq )
left join tbm_usr as usr on (usr.co_usr=a.co_usring )
where a.co_emp=$P{codEmp}
and a.co_loc=$P{codLoc}
and a.co_tipdoc=$P{codTipDoc}
and a.co_doc=$P{codDoc}
and a1.st_reg not in ('E') ORDER BY a1.co_reg]]>
	</queryString>
