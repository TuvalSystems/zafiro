	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="codEmp" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="codLoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="codTipDoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="codDoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="nomUsr" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT * FROM (
select emp.tx_nom as empresa, current_timestamp as fecimp,
a1.ne_numdoc, a1.co_cli, a1.tx_nomcli, a1.co_tipdoc, a5.tx_descor as descordep,
a5.tx_deslar as deslardep, a3.tx_numctachq, a3.tx_numchq, a3.nd_abo,
a3.co_banchq, a4.fe_doc, a4.tx_obs1, a4.ne_numdoc1 as numalt
, a6.co_cta, a6.tx_codcta, a6.tx_deslar as nomcta, abs(a4.nd_mondoc) as nd_mondoc, b1.tx_glo
from tbm_cabmovinv as a1
inner join tbm_pagmovinv as a2  on a1.co_emp=a2.co_emp and a1.co_loc=a2.co_loc and a1.co_tipdoc=a2.co_tipdoc and a1.co_doc=a2.co_doc
inner join tbm_detpag as a3 on a2.co_emp=a3.co_emp and a2.co_loc=a3.co_locpag and a2.co_tipdoc=a3.co_tipdocpag and a2.co_doc=a3.co_docpag and a2.co_reg=a3.co_regpag
inner join tbm_cabpag as a4 on a4.co_emp=a3.co_emp and a4.co_loc=a3.co_loc and a4.co_tipdoc=a3.co_tipdoc and a4.co_doc=a3.co_doc
inner join tbm_cabdia as b1 on a4.co_emp=b1.co_emp and a4.co_loc=b1.co_loc and a4.co_tipdoc=b1.co_tipdoc and a4.co_doc=b1.co_dia
inner join tbm_cabtipdoc as a5 on a5.co_emp=a3.co_emp and a5.co_loc=a3.co_loc and a5.co_tipdoc=a3.co_tipdoccon
inner join tbm_placta as a6 on a5.co_emp=a6.co_emp and a5.co_ctadeb=a6.co_cta
inner join tbm_emp as emp on ( emp.co_emp=a1.co_emp )
where a4.co_emp= $P{codEmp}
and a4.co_loc= $P{codLoc}
and a4.co_tipdoc= $P{codTipDoc}
and a4.co_doc= $P{codDoc}
AND a3.st_reg='A'
order by a3.co_reg
) AS x]]>
	</queryString>
