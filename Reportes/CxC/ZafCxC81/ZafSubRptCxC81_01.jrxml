	<queryString>
		<![CDATA[select a3.tx_descor, a2.co_cli, a2.tx_nomcli, a1.co_tipdoc, a2.ne_numdoc, a2.fe_doc, a1.mo_pag, a1.tx_numser, a1.tx_numchq, a1.tx_numautsri, a1.tx_feccad, a1.tx_codsri, a.nd_abo
     from tbm_detpag as a
     inner join tbm_pagmovinv as a1 on (a1.co_emp=a.co_emp and a1.co_loc=a.co_locpag and a1.co_tipdoc=a.co_tipdocpag and a1.co_doc=a.co_docpag and a1.co_reg=a.co_regpag )
     inner join tbm_cabmovinv as a2 on (a2.co_emp=a1.co_emp and a2.co_loc=a1.co_loc and a2.co_tipdoc=a1.co_tipdoc and a2.co_doc=a1.co_doc )
     inner join tbm_cabtipdoc as a3 on (a.co_emp=a3.co_emp and a.co_loc=a3.co_loc and a.co_tipdocpag=a3.co_tipdoc)

 WHERE a.co_emp=$P{co_emp} and a.co_loc=$P{co_loc}  and
     a.co_tipdoc=$P{co_tipdoc}  and a.co_doc=$P{co_doc}  and a.st_reg = 'A'  ORDER BY a.co_reg]]>
	</queryString>
