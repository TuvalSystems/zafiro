	<parameter name="strCamAudRpt" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[Campos de auditoria.
	strNomCla + strNomRpt + strUsr + strFecHorImp
strNomCla: Nombre de la clase desde la que se invoca al reporte
strNomRpt: Nombre del reporte
strUsr: Usuario que genera el reporte
strFecHorImp: Fecha y hora de impresión]]></parameterDescription>
	</parameter>
	<parameter name="co_usr" class="java.lang.Integer" isForPrompting="false">
		<parameterDescription><![CDATA[Código del usuario]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a1.tx_nom, a2.tx_nom AS tx_nomL, a3.tx_descor, a3.tx_deslar, a.co_doc, a.ne_numdoc1, a.fe_doc, a.nd_mondoc
  FROM  tbm_cabpag AS a
  INNER JOIN tbm_emp AS a1 ON(a.co_emp = a1.co_emp)
  INNER JOIN tbm_loc AS a2 ON(a.co_emp = a2.co_emp AND a.co_loc = a2.co_loc)
  INNER JOIN tbm_cabTipDoc AS a3 ON (a.co_emp=a3.co_emp AND a.co_loc=a3.co_loc AND a.co_tipDoc=a3.co_tipdoc)
  WHERE a.co_emp= $P{co_emp} AND a.co_loc= $P{co_loc} AND a.co_tipdoc=$P{co_tipdoc} AND a.co_doc=$P{co_doc}
ORDER BY a.co_emp, a.co_loc, a.co_tipdoc]]>
	</queryString>
