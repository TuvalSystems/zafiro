<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafSubRptCxC20_01_01" pageWidth="400" pageHeight="1124" columnWidth="400" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="CodEmp" class="java.lang.Integer" isForPrompting="false">
		<parameterDescription><![CDATA[Codigo de la Empresa]]></parameterDescription>
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="CodCli" class="java.lang.Integer" isForPrompting="false">
		<parameterDescription><![CDATA[Codigo del Cliente]]></parameterDescription>
		<defaultValueExpression><![CDATA[2127]]></defaultValueExpression>
	</parameter>
	<parameter name="NumDoc" class="java.lang.Integer" isForPrompting="false">
		<parameterDescription><![CDATA[Numero de Documento]]></parameterDescription>
		<defaultValueExpression><![CDATA[Integer.valueOf("9125")]]></defaultValueExpression>
	</parameter>
	<parameter name="Ban" class="java.lang.String">
		<defaultValueExpression><![CDATA[($P{Ban}==null?" ":$P{Ban})]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT a1.co_emp, a1.co_loc, a1.co_cli, a4.tx_nom AS NOM_CLI, a4.tx_ide AS RUC_CLI, a4.tx_dir AS DIR_CLI,
a4.tx_tel AS TEL_CLI, a4.tx_corele AS COR_ELE, a1.co_tipdoc, a3.tx_descor as TIPDOC_COR, a3.tx_deslar as NOM_LAR,
a1.co_doc as COD_DOC, a1.ne_numDoc as NUM_DOC,  a2.ne_diacre, a1.fe_doc as FEC_DOC, a2.fe_ven as FEC_VEN,
case when (CURRENT_DATE - a2.fe_ven) < 0 then 0
when (CURRENT_DATE - a2.fe_ven) > 0 then (CURRENT_DATE - a2.fe_ven) end as diasven,
case when round(a2.nd_porret,0)=0 then null when round(a2.nd_porret,0)<>0 then round(a2.nd_porret,0)||' %'  end AS POR_RET,
round((a2.mo_pag),2) as VAL_DOC,  round(a2.nd_abo,2) AS VAL_ABO,
case when a2.nd_porret = 0.00 then round(a2.mo_pag+a2.nd_abo,2) end AS VAL_PAG,
case when a2.nd_porret>0 then (a2.mo_pag+a2.nd_abo) end as ValRet,
a5.tx_descor AS DESCOR_BAN, a2.tx_numCtaChq AS NUM_CTA,
a2.tx_numChq AS NUM_CHQ, round(a2.nd_monChq,2) AS VAL_CHQ,
case when (current_date - a2.fe_ven) <= 0 then (a2.mo_pag+a2.nd_abo) end as ValxVen,
case when ((current_date - a2.fe_ven)>=1  and (current_date - a2.fe_ven) <=30) then (a2.mo_pag+a2.nd_abo) end as D1_D30,
case when ((current_date - a2.fe_ven)>=31 and (current_date - a2.fe_ven) <=60) then (a2.mo_pag+a2.nd_abo) end as D31_D60,
case when ((current_date - a2.fe_ven)>=61 and (current_date - a2.fe_ven) <=90) then (a2.mo_pag+a2.nd_abo) end as D61_D90,
case when ((current_date - a2.fe_ven)>=91) then (a2.mo_pag+a2.nd_abo) end as Dmas91
FROM tbm_cabMovInv AS a1
INNER JOIN tbm_pagMovInv AS a2 ON (a1.co_emp=a2.co_emp AND a1.co_loc=a2.co_loc AND a1.co_tipDoc=a2.co_tipDoc AND a1.co_doc=a2.co_doc)
INNER JOIN tbm_cabTipDoc AS a3 ON (a1.co_emp=a3.co_emp AND a1.co_loc=a3.co_loc AND a1.co_tipDoc=a3.co_tipDoc)
INNER JOIN tbm_cli AS a4 ON (a1.co_emp=a4.co_emp AND a1.co_cli=a4.co_cli)
LEFT OUTER JOIN tbm_var AS a5 ON (a2.co_banChq=a5.co_reg)
WHERE a1.st_reg IN ('A','R','C','F') AND a2.st_reg IN ('A','C')  AND a4.st_cli='S'
AND a3.ne_mod IN (1,3)
AND (a2.mo_pag+a2.nd_abo)<>0
AND a1.co_emp = $P{CodEmp}
AND a1.co_cli = $P{CodCli}
AND a1.ne_numdoc = $P{NumDoc}
$P!{Ban}
ORDER BY a3.tx_natdoc, a1.co_tipdoc, a1.ne_numdoc, a1.fe_doc, a2.co_reg]]>
	</queryString>
	<field name="co_emp" class="java.lang.Short"/>
	<field name="co_loc" class="java.lang.Short"/>
	<field name="co_cli" class="java.lang.Short"/>
	<field name="nom_cli" class="java.lang.String"/>
	<field name="ruc_cli" class="java.lang.String"/>
	<field name="dir_cli" class="java.lang.String"/>
	<field name="tel_cli" class="java.lang.String"/>
	<field name="cor_ele" class="java.lang.String"/>
	<field name="co_tipdoc" class="java.lang.Short"/>
	<field name="tipdoc_cor" class="java.lang.String"/>
	<field name="nom_lar" class="java.lang.String"/>
	<field name="cod_doc" class="java.lang.Integer"/>
	<field name="num_doc" class="java.lang.Integer"/>
	<field name="ne_diacre" class="java.lang.Short"/>
	<field name="fec_doc" class="java.sql.Date"/>
	<field name="fec_ven" class="java.sql.Date"/>
	<field name="diasven" class="java.lang.Integer"/>
	<field name="por_ret" class="java.lang.String"/>
	<field name="val_doc" class="java.lang.Double"/>
	<field name="val_abo" class="java.lang.Double"/>
	<field name="val_pag" class="java.lang.Double"/>
	<field name="valret" class="java.lang.Double"/>
	<field name="descor_ban" class="java.lang.String"/>
	<field name="num_cta" class="java.lang.String"/>
	<field name="num_chq" class="java.lang.String"/>
	<field name="val_chq" class="java.lang.Double"/>
	<field name="valxven" class="java.lang.Double"/>
	<field name="d1_d30" class="java.lang.Double"/>
	<field name="d31_d60" class="java.lang.Double"/>
	<field name="d61_d90" class="java.lang.Double"/>
	<field name="dmas91" class="java.lang.Double"/>
	<background>
		<band splitType="Stretch"/>
	</background>
