	<parameter name="RUTA_LOGO" class="java.lang.String"/>
	<parameter name="DirLoc" class="java.lang.String"/>
	<parameter name="TelLoc" class="java.lang.String"/>
	<parameter name="CiuLoc" class="java.lang.String"/>
