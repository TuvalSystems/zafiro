	<parameter name="strFecCor" class="java.lang.String"/>
	<parameter name="strAnd" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT a1.co_emp, a1.co_loc, a1.co_cli, a4.tx_nom AS NOM_CLI, a4.tx_ide AS RUC_CLI, a4.tx_dir AS DIR_CLI,
a4.tx_tel AS TEL_CLI, a4.tx_corele AS COR_ELE, a3.tx_descor as TIPDOC_COR, a3.tx_deslar as NOM_LAR,
a1.co_doc as COD_DOC, a1.ne_numDoc as NUM_DOC,  a1.fe_doc as FEC_DOC, a2.fe_ven as FEC_VEN,
case when round(a2.nd_porret,0)=0 then null when round(a2.nd_porret,0)!=0 then round(a2.nd_porret,0)||' %'  end AS POR_RET,
round((a2.mo_pag),2) as VAL_DOC,  round(CASE WHEN x1.sumabodet IS NULL THEN 0 ELSE x1.sumabodet END,2) AS VAL_ABO,
round(a2.mo_pag+CASE WHEN x1.sumabodet IS NULL THEN 0 ELSE x1.sumabodet END,2) AS VAL_PEN,  a5.tx_descor AS DESCOR_BAN, a2.tx_numCtaChq AS NUM_CTA,
a2.tx_numChq AS NUM_CHQ, round(a2.nd_monChq,2) AS VAL_CHQ,
case when (current_date - a2.fe_ven) <= 0 then round((a2.mo_pag+a2.nd_abo),2) end as ValxVen,
case when ((current_date - a2.fe_ven)>=1  and (current_date - a2.fe_ven) <=30) then round((a2.mo_pag+a2.nd_abo),2) end as D1_D30,
case when ((current_date - a2.fe_ven)>=31 and (current_date - a2.fe_ven) <=60) then round((a2.mo_pag+a2.nd_abo),2) end as D31_D60,
case when ((current_date - a2.fe_ven)>=61 and (current_date - a2.fe_ven) <=90) then round((a2.mo_pag+a2.nd_abo),2) end as D61_D90,
case when ((current_date - a2.fe_ven)>=91) then round((a2.mo_pag+a2.nd_abo),2) end as Dmas91
FROM tbm_cabMovInv AS a1
INNER JOIN tbm_pagMovInv AS a2 ON (a1.co_emp=a2.co_emp AND a1.co_loc=a2.co_loc AND a1.co_tipDoc=a2.co_tipDoc AND a1.co_doc=a2.co_doc)
INNER JOIN tbm_cabTipDoc AS a3 ON (a1.co_emp=a3.co_emp AND a1.co_loc=a3.co_loc AND a1.co_tipDoc=a3.co_tipDoc)
INNER JOIN tbm_cli AS a4 ON (a1.co_emp=a4.co_emp AND a1.co_cli=a4.co_cli)
LEFT OUTER JOIN tbm_var AS a5 ON (a2.co_banChq=a5.co_reg)
LEFT OUTER JOIN (
	SELECT x1.co_emp, x1.co_locpag, x1.co_tipdocpag, x1.co_docpag, x1.co_regpag  , sum(CASE WHEN x1.nd_abo IS NULL THEN 0 ELSE x1.nd_abo END) as sumabodet
	FROM tbm_detpag as x1
	INNER JOIN tbm_cabpag as a1 ON (x1.co_emp=a1.co_emp and x1.co_loc=a1.co_loc and x1.co_tipdoc=a1.co_tipdoc and x1.co_doc=a1.co_doc)
	WHERE a1.st_reg NOT IN ('E','I')   and  x1.st_reg NOT IN ('E','I')  $P!{strFecCor}
	GROUP BY x1.co_emp, x1.co_locpag, x1.co_tipdocpag, x1.co_docpag, x1.co_regpag
) as x1 ON (a2.co_emp=x1.co_emp and a2.co_loc=x1.co_locpag and a2.co_tipdoc=x1.co_tipdocpag and a2.co_doc=x1.co_docpag  and a2.co_reg=x1.co_regpag )

WHERE a1.st_reg IN ('A','R','C','F') AND a2.st_reg IN ('A','C')  AND a4.st_cli='S'
AND a3.ne_mod IN (1,3)
AND a1.co_emp = $P{CodEmp}
AND a1.co_cli = $P{CodCli}
$P!{Ban}
$P!{strFecCor}
$P!{strAnd}
ORDER BY a3.tx_natdoc, a1.co_tipdoc, a1.ne_numdoc, a2.co_reg, a1.fe_doc, a2.fe_ven]]>
	</queryString>
