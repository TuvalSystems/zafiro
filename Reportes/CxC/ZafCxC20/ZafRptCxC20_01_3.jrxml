<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafRptCxC20_01_3" pageWidth="472" pageHeight="1124" columnWidth="472" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="CodEmp" class="java.lang.Integer" isForPrompting="false">
		<parameterDescription><![CDATA[Codigo de la Empresa]]></parameterDescription>
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="CodCli" class="java.lang.Integer" isForPrompting="false">
		<parameterDescription><![CDATA[Codigo del Cliente]]></parameterDescription>
		<defaultValueExpression><![CDATA[2127]]></defaultValueExpression>
	</parameter>
	<parameter name="Ban" class="java.lang.String">
		<defaultValueExpression><![CDATA[($P{Ban}==null?" ":$P{Ban})]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT round(SUM(P.VAL_DOC),2) AS SUMVALDOC, round(SUM(P.VAL_ABO),2) AS SUMVALABO, round(SUM(P.VAL_COB),2) AS SUMVALCOB,
round(SUM(P.VAL_PAG),2) AS SUMVALPAG, round(SUM(P.VAL_RET),2) AS SUMVALRET, round(SUM(P.VAL_CHQ),2) AS SUMVALCHQ
FROM
(
SELECT a1.co_emp, a1.co_loc, a1.co_cli, a4.tx_nom AS NOM_CLI, a4.tx_ide AS RUC_CLI, a4.tx_dir AS DIR_CLI,
a4.tx_tel AS TEL_CLI, a4.tx_corele AS COR_ELE, a1.co_tipdoc, a3.tx_descor as TIPDOC_COR, a3.tx_deslar as NOM_LAR,
a1.co_doc as COD_DOC, a1.ne_numDoc as NUM_DOC,  a2.ne_diacre, a1.fe_doc as FEC_DOC, a2.fe_ven as FEC_VEN,
(current_date - a2.fe_ven) as diaven,
round(a2.nd_porret,1) AS POR_RET,
(a2.mo_pag) as VAL_DOC,  round(a2.nd_abo,4) AS VAL_ABO,
round(a2.mo_pag+a2.nd_abo,4) AS VAL_COB,
case when a2.nd_porret = 0.00 then round(a2.mo_pag+a2.nd_abo,4) end as VAL_PAG,
case when a2.nd_porret>0 then (a2.mo_pag+a2.nd_abo) end as VAL_RET,
a5.tx_descor AS DESCOR_BAN, a2.tx_numCtaChq AS NUM_CTA,
a2.tx_numChq AS NUM_CHQ, a2.nd_monChq AS VAL_CHQ,
case when (current_date - a2.fe_ven) <= 0 then (a2.mo_pag+a2.nd_abo) end as ValxVen,
case when ((current_date - a2.fe_ven)>=1  and (current_date - a2.fe_ven) <=30) then (a2.mo_pag+a2.nd_abo) end as D1_D30,
case when ((current_date - a2.fe_ven)>=31 and (current_date - a2.fe_ven) <=60) then (a2.mo_pag+a2.nd_abo) end as D31_D60,
case when ((current_date - a2.fe_ven)>=61 and (current_date - a2.fe_ven) <=90) then (a2.mo_pag+a2.nd_abo) end as D61_D90,
case when ((current_date - a2.fe_ven)>=91) then (a2.mo_pag+a2.nd_abo) end as Dmas91
FROM tbm_cabMovInv AS a1
INNER JOIN tbm_pagMovInv AS a2 ON (a1.co_emp=a2.co_emp AND a1.co_loc=a2.co_loc AND a1.co_tipDoc=a2.co_tipDoc AND a1.co_doc=a2.co_doc)
INNER JOIN tbm_cabTipDoc AS a3 ON (a1.co_emp=a3.co_emp AND a1.co_loc=a3.co_loc AND a1.co_tipDoc=a3.co_tipDoc)
INNER JOIN tbm_cli AS a4 ON (a1.co_emp=a4.co_emp AND a1.co_cli=a4.co_cli)
LEFT OUTER JOIN tbm_var AS a5 ON (a2.co_banChq=a5.co_reg)
WHERE a1.st_reg IN ('A','R','C','F') AND a2.st_reg IN ('A','C')  AND a4.st_cli='S'
AND a3.ne_mod IN (1,3)
AND (a2.mo_pag+a2.nd_abo)<>0
AND a1.co_emp = $P{CodEmp}
AND a1.co_cli = $P{CodCli}
$P!{Ban}
ORDER BY a3.tx_natdoc, a1.co_tipdoc, a1.ne_numdoc, a1.fe_doc, a2.co_reg
) AS P]]>
	</queryString>
	<field name="sumvaldoc" class="java.lang.Double"/>
	<field name="sumvalabo" class="java.lang.Double"/>
	<field name="sumvalcob" class="java.lang.Double"/>
	<field name="sumvalpag" class="java.lang.Double"/>
	<field name="sumvalret" class="java.lang.Double"/>
	<field name="sumvalchq" class="java.lang.Double"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="13" splitType="Stretch">
			<textField pattern="" isBlankWhenNull="true">
				<reportElement key="textField" x="0" y="1" width="45" height="11"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{sumvalcob}]]></textFieldExpression>
			</textField>
			<textField pattern="" isBlankWhenNull="true">
				<reportElement key="textField" x="90" y="1" width="45" height="11"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{sumvalpag}]]></textFieldExpression>
			</textField>
			<textField pattern="" isBlankWhenNull="true">
				<reportElement key="textField" x="175" y="1" width="45" height="11"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{sumvalret}]]></textFieldExpression>
			</textField>
			<textField pattern="" isBlankWhenNull="true">
				<reportElement key="textField" x="401" y="1" width="45" height="11"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="8" isBold="true" pdfFontName="Helvetica-Bold"/>
				</textElement>
				<textFieldExpression class="java.lang.Double"><![CDATA[$F{sumvalchq}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
