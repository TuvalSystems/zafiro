	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="co_doc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_emp" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_loc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_tipdoc" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[select a.co_cli, a3.tx_nom, a2.tx_descor , a2.tx_deslar, a.tx_numctachq, a.tx_numchq, a.fe_venchq, a.nd_monchq
,( select sum(x.nd_monchq)  from tbm_detrecdoc as x where x.co_emp=a.co_emp and x.co_loc=a.co_loc and x.co_tipdoc=a.co_tipdoc and x.co_doc=a.co_doc and x.st_reg='A' ) as montot
from tbm_detrecdoc as a
INNER JOIN tbm_cli as a3 ON (a3.co_emp=a.co_emp and a3.co_cli=a.co_cli)
LEFT  JOIN tbm_var as a2 ON (a2.co_reg=a.co_banchq )
where a.co_emp=$P{co_emp} and a.co_loc=$P{co_loc} and a.co_tipdoc=$P{co_tipdoc}
and a.co_doc=$P{co_doc}  and a.st_reg='A'  order by a.co_reg]]>
	</queryString>
