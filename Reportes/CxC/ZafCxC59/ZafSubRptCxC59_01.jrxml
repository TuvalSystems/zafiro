	<field name="tx_deslar" class="java.lang.String"/>
	<field name="tx_numctachq" class="java.lang.String"/>
	<field name="tx_numchq" class="java.lang.String"/>
	<field name="fe_venchq" class="java.sql.Date"/>
	<field name="nd_monchq" class="java.math.BigDecimal"/>
	<field name="montot" class="java.math.BigDecimal"/>
