	<queryString>
		<![CDATA[SELECT  a.co_emp, a.co_loc, a.co_tipdoc, a.co_doc, a4.tx_descor, a4.tx_deslar, a.ne_numdoc1, a.fe_doc , a.nd_mondoc
,( SELECT  sum(a.nd_mondoc)
FROM tbm_cabrecdoc as a
WHERE  a.st_reg not in ('I','E') and  a.co_emp=$P{coemp} $P!{strAux}
) as montot
FROM tbm_cabrecdoc as a
INNER JOIN tbm_cabtipdoc as a4 ON (a4.co_emp=a.co_emp and a4.co_loc=a.co_loc and a4.co_tipdoc=a.co_tipdoc )
WHERE a.st_reg not in ('I','E') and  a.co_emp=$P{coemp} $P!{strAux}]]>
	</queryString>
