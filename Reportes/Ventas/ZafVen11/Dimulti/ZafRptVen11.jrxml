	<queryString>
		<![CDATA[select distinct a4.tx_descor,a1.ne_numdoc,to_char(a1.fe_doc, 'dd/mon/yyyy') as fe_doc,a1.tx_nomcli,a5.tx_codalt2, a2.tx_unimed, a2.nd_candev,a3.ne_numorddes,to_char(a3.fe_doc, 'dd/mon/yyyy') as fe_docfac, case when (a6.nd_cancon is not null and a6.nd_cancon!=0) then 'S' else 'N' end as st_estguirem, case when a1.st_tipdev='P' then 'PORCENTAJE' when a1.st_tipdev='C' then 'CANTIDAD' when a1.st_tipdev='V' then 'PRECIO' when a1.st_tipdev='E' then 'DSCT ESPECIALES' END as st_tipdev,a7.tx_nom as tx_nomemp
                 from tbm_cabSolDevVen as a1
                 inner join tbm_detSolDevVen as a2 on (a1.co_emp=a2.co_emp and a1.co_loc=a2.co_loc and a1.co_tipdoc=a2.co_tipdoc and a1.co_doc=a2.co_doc)
                 inner join tbm_cabmovinv as a3 on (a1.co_emp=a3.co_emp and a1.co_locrel=a3.co_loc and a1.co_tipdocrel=a3.co_tipdoc and a1.co_docrel=a3.co_doc)
inner join tbm_cabtipdoc AS a4 ON(a1.co_emp=a4.co_emp AND a1.co_loc=a4.co_loc AND a1.co_tipdoc=a4.co_tipdoc)
                 inner join tbm_inv as a5 on(a2.co_emp=a5.co_emp and a2.co_itm=a5.co_itm)
inner join tbm_detmovinv as a6 on (a3.co_emp=a6.co_emp and a3.co_loc=a6.co_loc and a3.co_tipdoc=a6.co_tipdoc and a3.co_doc=a6.co_doc and a6.co_itm=a5.co_itm)
inner join tbm_emp as a7 on (a1.co_emp=a7.co_emp)
                 where a1.co_emp=$P{co_emp}
                 and a1.co_loc=$P{co_loc}
                 and a1.co_tipdoc=$P{co_tipdoc}
                 and a1.co_doc=$P{co_doc}
		 and a2.nd_candev>0]]>
	</queryString>
