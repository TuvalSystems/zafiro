	<queryString>
		<![CDATA[SELECT a.co_emp,
       a.co_loc,
       a.co_tipdoc,
       a.co_doc,
       case when a1.st_revtec in ('S') THEN 'DEV. VEN. # ' || a1.co_doc ||'. MERC. SUJ. REV. TECNICA.' ELSE 'DEVOLUCION VENTAS # '|| a1.co_doc END AS revtec,
       a1.tx_nomusrsol,
       a1.fe_doc,
       a1.co_cli,
       a1.ne_numdoc,
       a1.tx_nomcli,
       cli.tx_dircli,
       cli.tx_ciucli,
       cli.tx_telcli,
       cli.tx_ruc,
       cli.ne_numdoc as numfac,
       cli.ne_numgui,
       cli.fe_doc as fe_fac,
       emp.tx_nom,
       cli.tx_nomven,
       date(a1.fe_aut) as feaut,
       a.fe_doc as febod
FROM tbm_cabRecMerSolDevVen as a
INNER JOIN tbm_cabsoldevven AS a1 ON(a1.co_emp=a.co_emp AND a1.co_loc=a.co_locrel AND a1.co_tipdoc=a.co_tipdocrel AND a1.co_doc=a.co_docrel )
INNER JOIN tbm_cabmovinv AS cli ON(cli.co_emp=a1.co_emp AND cli.co_loc=a1.co_locrel AND cli.co_tipdoc=a1.co_tipdocrel AND cli.co_doc=a1.co_docrel )
inner join tbm_emp as emp ON(emp.co_emp=a1.co_emp)
WHERE a.co_emp=$P{codEmp}
and a.co_loc=$P{codLoc}
and a.co_tipdoc=$P{codTipDoc}
and a.co_doc=$P{codDoc}]]>
	</queryString>
