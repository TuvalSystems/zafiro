<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafRptVen28" pageWidth="595" pageHeight="842" columnWidth="559" leftMargin="24" rightMargin="12" topMargin="84" bottomMargin="14">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="codEmp" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="codLoc" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[4]]></defaultValueExpression>
	</parameter>
	<parameter name="codTipDoc" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[3]]></defaultValueExpression>
	</parameter>
	<parameter name="codDoc" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[37135]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["C:\\Zafiro_escritorio\\Reportes\\Ventas\\ZafVen28\\Tuval\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGO_DIR" class="java.lang.String"/>
	<queryString>
		<![CDATA[select case when b.st_tipdev = 'C' then '' else case when b.st_tipdev = 'P' then 'DESCUENTO' else case when b.st_tipdev = 'E' then 'DESCUENTO ESPECIAL' else case when b.st_tipdev = 'V' then 'DIFERENCIA DE PRECIO' else b.tx_obs2 END END END END AS txobs2,
CASE WHEN b.st_tipdev IN ('C') THEN null ELSE b.nd_sub END  AS subtotal,
b.co_emp,
b.co_loc,
b.co_tipdoc,
b.co_doc,
b.nd_sub,
b.nd_valcomsol,
b.nd_tot,
b.nd_valiva,
b.co_cli,
cli.tx_tel as tel, cli.tx_ide as ruc,cli.tx_dir,
cli.co_cli as cocli,
cli.tx_nom as nomcli,
b.tx_obs1,( 'IVA' || ' ' || round(b.nd_poriva) || '%') as iva,
emp.tx_desconesp as contri1,
usr.tx_nom as usuario,
b.fe_doc,
/*LPAD( text(b.ne_numcot) ,7,'0') AS ne_numcot,*/
/*LPAD( text(b.ne_numdoc) ,7,'0') AS ne_numdoc,*/

(to_char(b.ne_numdoc, '000000000')) as ne_numdoc,
(to_char(b.ne_numcot, '000000000')) as ne_numcot,
coalesce(datsri.tx_numserfac,loc.tx_secdoc) as tx_numserfac,
/* FACTURACION ELECTRONICA */ b.fe_autFacEle, b.tx_claAccFacEle, b.tx_numAutFacEle,emp.tx_desConEsp
from tbm_cabmovinv as b
inner join tbm_cli as cli on(b.co_emp=cli.co_emp and b.co_cli=cli.co_cli)
inner JOIN tbm_emp as emp ON ( emp.co_emp = b.co_emp)
left join tbm_usr as usr on (usr.co_usr=b.co_usring)
inner join tbm_loc as loc on(loc.co_emp=emp.co_emp and loc.co_loc=b.co_loc)
inner join tbm_cabsoldevven as soldev on (soldev.co_emp=b.co_emp and soldev.co_loc=b.co_locrelsoldevven and soldev.co_tipdoc=b.co_tipdocrelsoldevven and soldev.co_doc=b.co_docrelsoldevven)
left join tbm_datautsri as datsri ON(datsri.co_emp=b.co_emp and datsri.co_loc=b.co_loc and datsri.co_tipdoc=soldev.co_tipdoc and  b.ne_numcot between datsri.ne_numdocdes and datsri.ne_numdochas )
where b.co_emp = $P{codEmp}
and b.co_loc = $P{codLoc}
and b.co_tipdoc = $P{codTipDoc}
and b.co_doc = $P{codDoc}]]>
	</queryString>
