	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="fechaHor" class="java.lang.String" isForPrompting="false"/>
	<parameter name="codEmp" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="codLoc" class="java.lang.Integer"/>
	<parameter name="codTipDoc" class="java.lang.Integer"/>
	<parameter name="codDoc" class="java.lang.Integer"/>
	<parameter name="ambiente" class="java.lang.Integer"/>
	<parameter name="DesForPagSri" class="java.lang.String"/>
	<parameter name="RUTA_LOGO" class="java.lang.String"/>
	<queryString>
		<![CDATA[select (substring(loc.tx_secdoc,1,3) || '-' || substring(loc.tx_secdoc,5,3) || '-' || to_char(ne_numdoc, '000000000')) as tx_numdoc,
       emp.tx_ruc as tx_rucEmp, emp.tx_dir as tx_diremp,
       (loc.tx_dir || '.     Telf: ' || loc.tx_tel) as tx_dirLoc,
       DocCab.tx_clacon,
       DocCab.tx_numautfacele,
       DocCab.fe_autfacele,
       DocCab.tx_claaccfacele,
       usr.tx_nom as nomusring,
       DocCab.tx_obs1,
       loc.tx_dir as diremp,
       emp.tx_nom as nomemp,
       DocCab.tx_telcli,
       DocCab.tx_ruc,
       DocCab.tx_ate,
       DocCab.tx_numGuiRem,
       case when  DocCab.co_cli = 828 then 'Manta,' else '' end as feciu,
       DocCab.fe_doc,
       DocCab.tx_numped,
       DocCab.ne_numgui,
       DocCab.tx_desforpag,
       DocCab.tx_nomcli,
       DocCab.co_cli,
       ((case when cli.tx_corelefacele is not null then cli.tx_corelefacele else '' end) ||
        (case when cli.tx_corelefacele2 is not null then ('; ' || cli.tx_corelefacele2) else '' end)) as tx_corEleCliFacEle,
       DocCab.tx_nomven,
       DocCab.tx_dircli,
       DocCab.tx_vehret,
       DocCab.tx_choret,
       a3.tx_deslar,
       DocCab.nd_poriva as nd_porIva,
       abs(DocCab.nd_sub) as subtotal,
       abs(DocCab.nd_sub*(DocCab.nd_poriva/100)) as iva,
       abs((DocCab.nd_sub*(DocCab.nd_poriva/100))+DocCab.nd_sub) as total,
       case when inv.st_ser = 'S' then '(*) '|| a2.tx_codalt else a2.tx_codalt end as tx_codalt,
       	CASE WHEN DocCab.co_emp = 1 THEN
		CASE WHEN DocCab.co_cli = 33 THEN a2.tx_nomitm
		ELSE
		       CASE WHEN inv.st_ser = 'S' then 'SERVICIO: '|| a2.tx_nomItm ELSE
			    CASE WHEN trim(a2.tx_nomitm)=trim(inv.tx_nomitm) THEN a2.tx_nomitm
			    ELSE a2.tx_nomitm || ' (**) '
			    END
		       END
		END
	WHEN DocCab.co_emp = 2 THEN
		CASE WHEN DocCab.co_cli = 27 THEN a2.tx_nomitm
		ELSE
		       CASE WHEN inv.st_ser = 'S' then 'SERVICIO: '|| a2.tx_nomItm ELSE
			    CASE WHEN trim(a2.tx_nomitm)=trim(inv.tx_nomitm) THEN a2.tx_nomitm
			    ELSE a2.tx_nomitm || ' (**) '
			    END
		       END
		END
	WHEN DocCab.co_emp = 4 THEN
	       CASE WHEN DocCab.co_cli = 30 THEN a2.tx_nomitm
	       ELSE
		       CASE WHEN inv.st_ser = 'S' then 'SERVICIO: '|| a2.tx_nomItm ELSE
			    CASE WHEN trim(a2.tx_nomitm)=trim(inv.tx_nomitm) THEN a2.tx_nomitm
			    ELSE a2.tx_nomitm || ' (**) '
			    END
		       END
	       END
	END as tx_nomitm,
       abs(a2.nd_can) as can,
       a2.tx_unimed,
       a2.nd_preuni,
       a2.nd_pordes,
       abs(a2.nd_can*a2.nd_preuni) as precan,
       ((a2.nd_can*abs(a2.nd_preuni))*(a2.nd_pordes/100)) as des,
       ROUND(  abs((a2.nd_can*abs(a2.nd_preuni))-((a2.nd_can*abs(a2.nd_preuni))*(a2.nd_pordes/100))) ,2) as tot,
       abs(DocCab.nd_sub) as sub,
       abs(DocCab.nd_valiva) as valiva,
       abs(DocCab.nd_tot) as  total_bas,
       DocCab.tx_ciucli as cuidad,
       emp.tx_desconesp,
       case when (ne_numdocree is not null) then ( 'Factura No ' || ne_numdoc  || ' Reemplaza a la Factura No ' ||  ne_numdocree ) end as Reem,
       (select sum( (inv.nd_pesitmkgr*abs(x.nd_can)) ) as kgramo
        from tbm_detmovinv as x
        inner join tbm_inv as inv on (x.co_emp=inv.co_emp and x.co_itm=inv.co_itm)
        WHERE x.co_emp=DocCab.co_emp and x.co_loc=DocCab.co_loc  and x.co_tipdoc=DocCab.co_tipdoc and x.co_doc=DocCab.co_doc ) as kgramo,
       (select sum( (((inv.nd_pesitmkgr*abs(x.nd_can))*2.2)/100)  ) as kilo
        from tbm_detmovinv as x
        inner join tbm_inv as inv on(x.co_emp=inv.co_emp and x.co_itm=inv.co_itm)
        WHERE x.co_emp=DocCab.co_emp and x.co_loc=DocCab.co_loc  and x.co_tipdoc=DocCab.co_tipdoc and x.co_doc=DocCab.co_doc ) as kilo, DocCab.nd_valComSol
FROM tbm_cabMovInv as DocCab
INNER JOIN tbm_detmovinv as a2 ON (DocCab.co_emp=a2.co_emp and DocCab.co_loc=a2.co_loc and DocCab.co_tipdoc=a2.co_tipdoc and DocCab.co_doc=a2.co_doc)
inner join tbm_inv as inv on (a2.co_emp=inv.co_emp and a2.co_itm=inv.co_itm)
inner JOIN tbm_loc as loc ON (doccab.co_emp = loc.co_emp and  doccab.co_loc=loc.co_loc)
inner JOIN tbm_ciu as ciu ON (loc.co_ciu = ciu.co_ciu)
inner JOIN tbm_emp as emp ON (emp.co_emp = DocCab.co_emp)
inner JOIN tbm_usr as usr ON (usr.co_usr = DocCab.co_usring)
LEFT OUTER JOIN tbm_var as a3 ON (DocCab.co_forret = a3.co_reg)
LEFT OUTER JOIN tbm_cli as cli ON (DocCab.co_emp = cli.co_emp and DocCab.co_cli = cli.co_cli)
WHERE DocCab.co_emp = $P{codEmp}
and DocCab.co_loc = $P{codLoc}
and DocCab.co_tipdoc = $P{codTipDoc}
and DocCab.co_doc = $P{codDoc}]]>
	</queryString>
