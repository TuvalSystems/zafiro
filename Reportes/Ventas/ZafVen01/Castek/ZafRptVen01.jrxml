<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafRptVen01" pageWidth="595" pageHeight="842" columnWidth="536" leftMargin="29" rightMargin="30" topMargin="18" bottomMargin="47" uuid="bb500354-aee2-4e62-93a3-c78de5830691">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.3636363636363642"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="codEmp" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="codLoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="forPag" class="java.lang.String" isForPrompting="false"/>
	<parameter name="co_cot" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="RUTA_LOGO" class="java.lang.String"/>
	<queryString>
		<![CDATA[select loc.ne_diavalcotven as vali,  a.fe_val as fecha,
a.co_cot, a.fe_cot, a.tx_ate, emp.tx_nom as nomempresa,a1.tx_codALt,
a1.tx_codalt2, a1.tx_nomitm, a1.nd_can, a1.nd_preuni, a1.nd_pordes,
(a1.nd_can*a1.nd_preuni) as subTot, ((a1.nd_can*a1.nd_preuni)*(a1.nd_pordes/100)) as valDsc,
ROUND( ((a1.nd_can*a1.nd_preuni) - ((a1.nd_can*a1.nd_preuni)*(a1.nd_pordes/100) ) ) ,2) as tot
, a5.tx_descor
,a.co_cli as cocli, a.co_ven as coven,a.tx_obs1,cli.tx_nom,cli.tx_tel,cli.tx_dir,a.nd_sub,a.nd_valiva,a.nd_tot
,ven.tx_nom as nomven, cli.tx_ide as ruc,loc.tx_tel as telemp, loc.tx_dir as diremp,loc.tx_fax as faxemp
,emp.tx_ruc as rucemp, loc.tx_dir as dirLoc, a.nd_valComSol
from tbm_cabcotven as a
inner join tbm_detcotven as a1 on (a.co_emp=a1.co_emp and a.co_loc=a1.co_loc and a.co_cot=a1.co_cot)
inner join tbm_inv as a4 on (a1.co_emp=a4.co_emp and a1.co_itm=a4.co_itm)
left outer join tbm_var as a5 on (a4.co_uni=a5.co_reg )
inner join tbm_cli as cli on (a.co_emp=cli.co_emp and a.co_cli=cli.co_cli)
left outer join tbm_usr as ven on (a.co_ven=ven.co_usr )
left outer join tbm_emp as emp on (a.co_emp=emp.co_emp)
inner JOIN tbm_loc as loc ON ( loc.co_emp = a.co_emp and loc.co_loc=a.co_loc)
where
     a.co_emp=$P{codEmp}
and a.co_loc=$P{codLoc}
and a.co_cot=$P{co_cot}
order by a1.co_reg]]>
	</queryString>
