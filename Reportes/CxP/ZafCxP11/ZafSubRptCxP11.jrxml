<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafSubRptCxP11" pageWidth="611" pageHeight="555" orientation="Landscape" columnWidth="611" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="4.0"/>
	<property name="ireport.x" value="758"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="co_doc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_emp" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_loc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_tipdoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_reg" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[select a.co_loc, a2.tx_descor, a1.ne_numdoc1, a1.ne_numdoc2, a1.fe_doc, a.nd_abo from tbm_detpag as a
inner join tbm_cabpag as a1 on (a1.co_emp=a.co_emp and a1.co_loc=a.co_loc and a1.co_tipdoc=a.co_tipdoc and a1.co_doc=a.co_doc )
inner join tbm_cabtipdoc as a2 on (a2.co_emp=a.co_emp and a2.co_loc=a.co_loc and a2.co_tipdoc=a.co_tipdoc  )
where a.co_emp=$P{co_emp}
and a.co_locpag=$P{co_loc}
and  a.co_tipdocpag=$P{co_tipdoc}
and a.co_docpag=$P{co_doc}
and a.co_regpag=$P{co_reg}
and a1.st_reg not in ('I','E')]]>
	</queryString>
	<field name="co_loc" class="java.lang.Integer"/>
	<field name="tx_descor" class="java.lang.String"/>
	<field name="ne_numdoc1" class="java.lang.Integer"/>
	<field name="ne_numdoc2" class="java.lang.Integer"/>
	<field name="fe_doc" class="java.sql.Date"/>
	<field name="nd_abo" class="java.math.BigDecimal"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="15" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="16" y="0" width="15" height="14"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{co_loc}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="30" y="0" width="53" height="14"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{tx_descor}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy" isBlankWhenNull="true">
				<reportElement x="142" y="0" width="59" height="14"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[$F{fe_doc}]]></textFieldExpression>
			</textField>
			<textField pattern="###0.00;(###0.00)" isBlankWhenNull="true">
				<reportElement x="201" y="0" width="56" height="14"/>
				<textElement textAlignment="Right">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{nd_abo}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="84" y="0" width="57" height="14"/>
				<textElement>
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{ne_numdoc1}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
	<lastPageFooter>
		<band splitType="Stretch"/>
	</lastPageFooter>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
