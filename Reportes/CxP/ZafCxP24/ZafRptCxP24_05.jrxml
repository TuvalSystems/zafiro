				<textElement textAlignment="Justified" markup="none"/>
				<textFieldExpression class="java.lang.String"><![CDATA["Nuestro Agente de Aduanas  es el Sr. Ing. Mario Gino Coka Borja  CI:0902897503  y  sus colaboradores  son  Sr. Xavier Lorenzo Pinela Rodriguez CI:0924837438, Sr. Manuel Enrique Rodriguez Silva  CI:0915065106 o nuestro colaborador Sr. Edison Moncada Mora, serán las personas encargadas de realizar dichas gestiones."]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="22" y="172" width="492" height="51"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression class="java.lang.String"><![CDATA["Por medio de la presente solicito debitar de la cuenta corriente arriba indicada el valor de US$" + $F{nd_valtra} + "("  + $F{tx_valtrapal} + ") para el pago de impuestos y derechos arancelarios según DAU No." + $F{nd_valdau} + " trámite a realizarse en el Puerto de Guayaquil."]]></textFieldExpression>
			</textField>
