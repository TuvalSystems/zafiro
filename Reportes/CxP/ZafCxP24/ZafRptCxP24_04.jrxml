			<staticText>
				<reportElement x="22" y="321" width="492" height="28"/>
				<textElement textAlignment="Justified" markup="none"/>
				<text><![CDATA[Los documentos de respaldo de las obligaciones antes indicadas serán presentados por ventanilla por nuestro (s) Agente (s) Afianzados(s).]]></text>
			</staticText>
			<staticText>
				<reportElement x="22" y="238" width="117" height="26"/>
				<textElement textAlignment="Justified" markup="none"/>
				<text><![CDATA[#Liquidación   Ecuapass /  Referencia]]></text>
			</staticText>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="22" y="177" width="492" height="51"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression class="java.lang.String"><![CDATA["En mi calidad de titular de la cuenta de referencia, solicito a Produbanco que para el pago de las obligaciones abajo indicadas bajo mi única y exclusiva responsabilidad, proceda a débito de los valores que se detallan a continuación, de la cuenta No. " + $F{tx_numctabanegr} + " que mantengo en PRODUBANCO."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="22" y="42" width="37" height="14"/>
				<textElement markup="none"/>
				<text><![CDATA[Fecha:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
