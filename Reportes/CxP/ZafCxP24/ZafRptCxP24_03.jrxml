			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="2" y="177" width="476" height="52"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression class="java.lang.String"><![CDATA["Por medio de la presente solicito a Uds. se sirva debitar de nuestra " + ($F{tx_tipctabanegraho}.toString().equals("")?"Cuenta de Ahorro":"Cuenta Corriente"           )    +           " # " + $F{tx_numctabanegr} + " a nombre de " + $F{tx_nomemp} + " el valor de "  + $F{tx_valtrapal} + " (US$ " + $F{nd_valtra} + ") indico desglose del mismo:"]]></textFieldExpression>
