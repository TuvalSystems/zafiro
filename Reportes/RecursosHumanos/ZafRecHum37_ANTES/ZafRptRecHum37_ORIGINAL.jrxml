	<queryString>
		<![CDATA[select a.co_tra, (b.tx_ape || ' ' || b.tx_nom) as empleado from tbm_traemp a
inner join tbm_tra b on (a.co_tra=b.co_tra)
and a.co_emp=1
where a.st_reg='A']]>
