	<subDataset name="Table Dataset 1">
		<parameter name="strsql" class="java.lang.String"/>
		<queryString>
			<![CDATA[$P!{strsql}]]>
		</queryString>
		<field name="co_emp" class="java.lang.Integer"/>
		<field name="co_tra" class="java.lang.Integer"/>
		<field name="ne_ani" class="java.lang.Integer"/>
		<field name="nd_valrub" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="co_tra" class="java.lang.Integer"/>
	<parameter name="co_emp" class="java.lang.Integer"/>
	<parameter name="co_loc" class="java.lang.Integer"/>
	<parameter name="co_tipdoc" class="java.lang.Integer"/>
	<parameter name="co_doc" class="java.lang.Integer"/>
	<parameter name="strperiodo" class="java.lang.String"/>
	<queryString>
		<![CDATA[select (c.tx_ape || ' '  || c.tx_nom) as empleado, b.tx_nom,
case when a.nd_valrub>0 then round(a.nd_valrub,2) else null end as nd_valRubIng,
case when a.nd_valrub<0 then round((a.nd_valrub*-1),2) else null end as nd_valRubEgr,

round((select sum(nd_valrub) as nd_valRubIng from tbm_detrolpag x
inner join tbm_rubrolpag y on (y.tx_tiprub='I' and x.co_rub=y.co_rub)
where x.co_emp = a.co_emp and x.co_loc=a.co_loc and x.co_tipdoc=a.co_tipdoc and x.co_doc=a.co_doc and x.co_tra=a.co_tra),2) as nd_totIng,

round((select sum(nd_valrub) as nd_valRubIng from tbm_detrolpag x
inner join tbm_rubrolpag y on (y.tx_tiprub='E' and x.co_rub=y.co_rub)
where x.co_emp = a.co_emp and x.co_loc=a.co_loc and x.co_tipdoc=a.co_tipdoc and x.co_doc=a.co_doc and x.co_tra=a.co_tra),2) as nd_totEgr,


case
(round(( (select sum(nd_valrub) as nd_valRubIng from tbm_detrolpag x
inner join tbm_rubrolpag y on (y.tx_tiprub='I' and x.co_rub=y.co_rub)
where x.co_emp = a.co_emp and x.co_loc=a.co_loc and x.co_tipdoc=a.co_tipdoc and x.co_doc=a.co_doc and x.co_tra=a.co_tra) -
(select (sum(nd_valrub)*-1) as nd_valRubEgr from tbm_detrolpag x
inner join tbm_rubrolpag y on (y.tx_tiprub='E' and x.co_rub=y.co_rub)
where x.co_emp = a.co_emp and x.co_loc=a.co_loc and x.co_tipdoc=a.co_tipdoc and x.co_doc=a.co_doc and x.co_tra=a.co_tra) ),2) is null--as nd_netorecibir
) when true then

round(( (select sum(nd_valrub) as nd_valRubIng from tbm_detrolpag x
inner join tbm_rubrolpag y on (y.tx_tiprub='I' and x.co_rub=y.co_rub)
where x.co_emp = a.co_emp and x.co_loc=a.co_loc and x.co_tipdoc=a.co_tipdoc and x.co_doc=a.co_doc and x.co_tra=a.co_tra) -
0 ),2)


else round(( (select sum(nd_valrub) as nd_valRubIng from tbm_detrolpag x
inner join tbm_rubrolpag y on (y.tx_tiprub='I' and x.co_rub=y.co_rub)
where x.co_emp = a.co_emp and x.co_loc=a.co_loc and x.co_tipdoc=a.co_tipdoc and x.co_doc=a.co_doc and x.co_tra=a.co_tra) -
(select (sum(nd_valrub)*-1) as nd_valRubEgr from tbm_detrolpag x
inner join tbm_rubrolpag y on (y.tx_tiprub='E' and x.co_rub=y.co_rub)
where x.co_emp = a.co_emp and x.co_loc=a.co_loc and x.co_tipdoc=a.co_tipdoc and x.co_doc=a.co_doc and x.co_tra=a.co_tra) ),2) end as nd_netorecibir








from tbm_detrolpag a
inner join tbm_rubrolpag b on (a.co_rub=b.co_rub and b.co_grp=3)
inner join tbm_tra c on (a.co_tra=c.co_tra)
inner join tbm_traemp d on (d.co_tra=a.co_tra and d.co_emp=a.co_emp)
where a.co_emp=$P{co_emp}
and a.co_loc=$P{co_loc}
and a.co_tipdoc=$P{co_tipdoc}
and a.co_doc=$P{co_doc}
and a.co_tra=$P{co_tra}
AND b.co_rub NOT IN (23,26,28)
order by empleado,a.co_rub]]>
	</queryString>
	<field name="tx_nom" class="java.lang.String"/>
	<field name="nd_valrubegr" class="java.math.BigDecimal"/>
	<field name="nd_valrubing" class="java.math.BigDecimal"/>
	<field name="nd_totegr" class="java.math.BigDecimal"/>
	<field name="nd_toting" class="java.math.BigDecimal"/>
	<field name="nd_netorecibir" class="java.math.BigDecimal"/>
	<variable name="nd_valrubing_1" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{nd_valrubing}]]></variableExpression>
	</variable>
