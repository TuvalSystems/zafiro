	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="co_nov" class="java.lang.Integer"/>
	<parameter name="strCamAudRpt" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT co_nov, tx_asu, tx_men, a.fe_ing, tx_deslar as tx_tipnov, c.tx_usr as tx_usrrem, c.tx_nom as tx_nomusrrem,d.tx_usr as tx_usrdes, d.tx_nom as tx_nomusrdes  FROM tbm_novrechum a
INNER JOIN tbm_tipnovrechum b on (b.co_tipnov=a.co_tipnov)
INNER JOIN tbm_usr c on (c.co_usr=a.co_usrrem)
INNER JOIN tbm_usr d on (d.co_usr=a.co_usrdes)
WHERE co_nov = $P{co_nov}]]>
	</queryString>
	<field name="co_nov" class="java.lang.Integer"/>
	<field name="tx_asu" class="java.lang.String"/>
	<field name="tx_men" class="java.lang.String"/>
	<field name="fe_ing" class="java.sql.Timestamp"/>
