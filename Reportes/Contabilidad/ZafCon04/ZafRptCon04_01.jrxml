	<parameter name="CodEmp" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="CodLoc" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[4]]></defaultValueExpression>
	</parameter>
	<parameter name="CodTipDoc" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[38]]></defaultValueExpression>
	</parameter>
	<parameter name="CodDoc" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[100]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.tx_nomcli,a.tx_dircli,a.tx_ruc,a.tx_telcli , a.tx_obs1 , a.tx_obs2 , a.fe_doc,
round(a.nd_sub,2) as sub ,
round(a.nd_valiva,2) as iva ,
round(a.nd_tot,2) as total
from tbm_cabmovinv as a
where a.co_emp=$P{CodEmp}
and a.co_loc=$P{CodLoc}
and a.co_tipdoc=$P{CodTipDoc}
and a.co_doc=$P{CodDoc}]]>
	</queryString>
