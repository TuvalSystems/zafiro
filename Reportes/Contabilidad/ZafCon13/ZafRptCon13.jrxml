				<textField isStretchWithOverflow="true" pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
					<reportElement key="txtSalAcu-1" mode="Transparent" x="456" y="4" width="79" height="16" forecolor="#000000" backcolor="#FFFFFF"/>
					<box>
