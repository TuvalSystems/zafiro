<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Rpt_ZafCon15" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="569" leftMargin="20" rightMargin="6" topMargin="42" bottomMargin="56">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="co_emp" class="java.lang.String"/>
	<parameter name="fecha_ini" class="java.lang.String"/>
	<parameter name="fecha_fin" class="java.lang.String"/>
	<parameter name="co_codcta" class="java.lang.String"/>
	<parameter name="tx_nomemp" class="java.lang.String" isForPrompting="false"/>
	<parameter name="tx_codcta" class="java.lang.String" isForPrompting="false"/>
	<parameter name="tx_descta" class="java.lang.String" isForPrompting="false"/>
	<parameter name="fecha_rep" class="java.lang.String" isForPrompting="false"/>
	<parameter name="nd_saldoant" class="java.lang.Double" isForPrompting="false"/>
	<parameter name="nd_saldoacum" class="java.lang.Double" isForPrompting="false"/>
	<parameter name="co_prv" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="strCamAudRpt" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT x.co_emp, x.co_loc, x.co_tipDoc, x.co_dia,
	x.fe_dia, x.descrip as descrip,
	CASE WHEN y.tx_nomCli IS NULL THEN x.tx_glo
	     WHEN y.tx_nomCli = (cast('' as character varying)) THEN x.tx_glo
	ELSE y.tx_nomCli END AS tx_nomCli,
	CASE WHEN y.ne_numDoc IS NULL THEN x.ne_numDoc
	ELSE y.ne_numDoc END AS ne_numDoc,
	CASE WHEN y.ne_numDoc2 IS NULL THEN x.tx_numDia
	ELSE y.ne_numDoc2 END AS ne_numDoc2,
	SUM(x.monDeb) as monDeb, 	SUM(x.monHab) AS monHab, SUM(x.monDeb - x.monHab) as saldo
FROM(
	SELECT a2.co_emp, a2.co_loc, a2.co_tipDoc, a2.co_dia,
	a2.fe_dia, a4.tx_desCor as descrip, a2.tx_numDia as ne_numDoc, ''||Null as tx_numDia
	, a2.tx_glo as tx_nomCli, a2.tx_glo, SUM(a3.nd_monDeb) as monDeb,
	SUM(a3.nd_monHab) as monHab, SUM(a3.nd_monDeb)-SUM(a3.nd_monHab) as saldo
	FROM tbm_cabDia AS a2 INNER JOIN tbm_detDia AS a3
	ON (a2.co_emp=a3.co_emp AND a2.co_loc=a3.co_loc AND a2.co_tipDoc=a3.co_tipDoc AND a2.co_dia=a3.co_dia)
	INNER JOIN tbm_cabTipDoc AS a4 ON (a2.co_emp=a4.co_emp AND a2.co_loc=a4.co_loc AND a2.co_tipDoc=a4.co_tipDoc)
		WHERE a2.co_emp=$P{co_emp} AND a3.co_cta=$P{co_codcta}  AND (a2.fe_dia BETWEEN $P{fecha_ini} AND $P{fecha_fin})
	AND a2.st_reg='A'
	GROUP BY a2.co_emp, a2.co_loc, a2.co_tipDoc, a2.co_dia, a2.fe_dia, a4.tx_desCor, a2.tx_numDia, a2.tx_numDia, a2.tx_glo, a2.tx_glo
	ORDER BY fe_dia, descrip, ne_numDoc) AS x


LEFT OUTER JOIN
(
	SELECT a2.co_emp, a2.co_loc, a2.co_tipDoc, a2.co_dia,
	a2.fe_dia, a4.tx_desCor as descrip, ''||a1.ne_numDoc as ne_numDoc, ''||Null AS ne_numDoc2, a1.tx_nomCli, a2.tx_glo, SUM(a3.nd_monDeb) as monDeb,
	SUM(a3.nd_monHab) as monHab, SUM(a3.nd_monDeb)-SUM(a3.nd_monHab) as saldo
	FROM tbm_cabMovInv AS a1
	INNER JOIN tbm_cabDia AS a2 ON (a1.co_emp=a2.co_emp AND a1.co_loc=a2.co_loc AND a1.co_tipDoc=a2.co_tipDoc AND a1.co_doc=a2.co_dia)
	INNER JOIN tbm_detDia AS a3 ON (a2.co_emp=a3.co_emp AND a2.co_loc=a3.co_loc AND a2.co_tipDoc=a3.co_tipDoc AND a2.co_dia=a3.co_dia)
	INNER JOIN tbm_cabTipDoc AS a4 ON (a2.co_emp=a4.co_emp AND a2.co_loc=a4.co_loc AND a2.co_tipDoc=a4.co_tipDoc)
	WHERE a2.co_emp=$P{co_emp} AND a3.co_cta=$P{co_codcta} AND (a2.fe_dia BETWEEN $P{fecha_ini} AND $P{fecha_fin})
	AND a2.st_reg='A'

	AND CASE WHEN $P{co_prv} <> 0 THEN a1.co_cli= $P{co_prv}
	ELSE a1.co_cli<> $P{co_prv} END

	GROUP BY a2.co_emp, a2.co_loc, a2.co_tipDoc, a2.co_dia,a2.fe_dia, a4.tx_desCor, a1.ne_numDoc, a1.tx_nomCli, a2.tx_glo
	UNION ALL
	/*OBTENER LOS DATOS DE tbm_cabPag.*/
	SELECT a2.co_emp, a2.co_loc, a2.co_tipDoc, a2.co_dia,
	a2.fe_dia, a4.tx_desCor as descrip, ''||a1.ne_numDoc1 as ne_numDoc, ''||a1.ne_numDoc2, a1.tx_nomCli, a2.tx_glo, SUM(a3.nd_monDeb) as monDeb,
	SUM(a3.nd_monHab) as monHab, SUM(a3.nd_monDeb)-SUM(a3.nd_monHab) as saldo
	FROM tbm_cabPag AS a1
	left OUTER JOIN tbm_cabDia AS a2 ON (a1.co_emp=a2.co_emp AND a1.co_loc=a2.co_loc AND a1.co_tipDoc=a2.co_tipDoc AND a1.co_doc=a2.co_dia)
	INNER JOIN tbm_detDia AS a3 ON (a2.co_emp=a3.co_emp AND a2.co_loc=a3.co_loc AND a2.co_tipDoc=a3.co_tipDoc AND a2.co_dia=a3.co_dia)
	INNER JOIN tbm_cabTipDoc AS a4 ON (a2.co_emp=a4.co_emp AND a2.co_loc=a4.co_loc AND a2.co_tipDoc=a4.co_tipDoc)
	WHERE a2.co_emp=$P{co_emp} AND a3.co_cta=$P{co_codcta}  AND (a2.fe_dia BETWEEN $P{fecha_ini} AND $P{fecha_fin})
	AND a2.st_reg='A'

	AND CASE WHEN $P{co_prv} <> 0 THEN a1.co_cli= $P{co_prv}
	ELSE a1.co_cli<> $P{co_prv} END

	GROUP BY a2.co_emp, a2.co_loc, a2.co_tipDoc, a2.co_dia, a2.fe_dia, a4.tx_desCor, a1.ne_numDoc1, a1.ne_numDoc2, a1.tx_nomCli, a2.tx_glo) AS y
ON x.co_emp=y.co_emp AND x.co_loc=y.co_loc AND x.co_tipDoc=y.co_tipDoc AND x.co_dia=y.co_dia
GROUP BY x.co_emp, x.co_loc, x.co_tipDoc, x.co_dia,
	x.fe_dia, y.tx_nomCli, x.descrip, x.ne_numDoc, y.ne_numDoc, x.tx_numDia, x.tx_nomCli,x.tx_glo, y.ne_numDoc2
ORDER BY x.fe_dia, x.descrip, x.ne_numDoc]]>
	</queryString>
	<field name="co_emp" class="java.lang.Integer"/>
	<field name="co_loc" class="java.lang.Integer"/>
	<field name="co_tipdoc" class="java.lang.Integer"/>
	<field name="co_dia" class="java.lang.Integer"/>
	<field name="fe_dia" class="java.sql.Date"/>
	<field name="descrip" class="java.lang.String"/>
