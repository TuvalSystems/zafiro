	<field name="saldo" class="java.math.BigDecimal"/>
	<variable name="varSaldo" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{saldo}]]></variableExpression>
	</variable>
	<variable name="varDescrip" class="java.lang.String">
		<variableExpression><![CDATA[$F{tx_nomcli}]]></variableExpression>
	</variable>
