<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafSubRptCoon36_01" pageWidth="611" pageHeight="555" orientation="Landscape" columnWidth="611" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="3.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="co_emp" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_loc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_tipdoc" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[select *

  , case when x.co_grptipdoc = 4 then
               (
                select min(a.fe_doc) as fecdes  from tbm_cabguirem as a
                INNER JOIN tbr_bodEmpBodGrp AS a6 ON (a6.co_emp=a.co_emp AND a6.co_bod=a.co_ptopar)
                where  ( a6.co_empGrp=0 AND a6.co_bodGrp=( x.co_bodgrp ) ) and a.ne_numdoc between x.ne_numdocdes and x.ne_numdochas
              )
            else case when x.co_grptipdoc = 5 then
            (
                 select min(a.fe_doc) as fecdes from tbm_cabpag as a
                 where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc
                 and a.ne_numdoc1 between x.ne_numdocdes and x.ne_numdochas
               )
            else
            (
                   select min(a.fe_doc) as fecdes  from tbm_cabmovinv as a
                    where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc
                    and a.ne_numdoc between x.ne_numdocdes and x.ne_numdochas
               )
             end end   as fecdes



  , case when x.co_grptipdoc = 4 then
               (
                select max(a.fe_doc) as fechas  from tbm_cabguirem as a
                INNER JOIN tbr_bodEmpBodGrp AS a6 ON (a6.co_emp=a.co_emp AND a6.co_bod=a.co_ptopar)
                where  ( a6.co_empGrp=0 AND a6.co_bodGrp=( x.co_bodgrp ) ) and a.ne_numdoc between x.ne_numdocdes and x.ne_numdochas
              )
            else case when x.co_grptipdoc = 5 then
            (
                 select max(a.fe_doc) as fechas from tbm_cabpag as a
                 where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc
                 and a.ne_numdoc1 between x.ne_numdocdes and x.ne_numdochas
               )
            else
            (
                   select max(a.fe_doc) as fechas  from tbm_cabmovinv as a
                    where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc
                    and a.ne_numdoc between x.ne_numdocdes and x.ne_numdochas
               )
             end end   as fechas






  , case when x.co_grptipdoc = 4 then
               (
                select  max(a.ne_numdoc) as ultdocuti from tbm_cabguirem as a
                INNER JOIN tbr_bodEmpBodGrp AS a6 ON (a6.co_emp=a.co_emp AND a6.co_bod=a.co_ptopar)
                where  ( a6.co_empGrp=0 AND a6.co_bodGrp=( x.co_bodgrp ) ) and a.ne_numdoc between x.ne_numdocdes and x.ne_numdochas
              )
            else case when x.co_grptipdoc = 5 then
            (
                 select max(a.ne_numdoc1) as ultdocuti from tbm_cabpag as a
                 where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc
                 and a.ne_numdoc1 between x.ne_numdocdes and x.ne_numdochas
               )
            else
            (
                   select max(a.ne_numdoc) as ultdocuti  from tbm_cabmovinv as a
                    where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc
                    and a.ne_numdoc between x.ne_numdocdes and x.ne_numdochas
               )
             end end   as ultdocuti






, case when x.co_grptipdoc = 4 then
               (
                select  count(a.ne_numdoc) as totdocuti from tbm_cabguirem as a
                INNER JOIN tbr_bodEmpBodGrp AS a6 ON (a6.co_emp=a.co_emp AND a6.co_bod=a.co_ptopar)
                where  ( a6.co_empGrp=0 AND a6.co_bodGrp=( x.co_bodgrp ) ) and a.ne_numdoc between x.ne_numdocdes and x.ne_numdochas
              )
            else case when x.co_grptipdoc = 5 then
            (
                 select count(a.ne_numdoc1) as totdocuti from tbm_cabpag as a
                 where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc
                 and a.ne_numdoc1 between x.ne_numdocdes and x.ne_numdochas
               )
            else
            (
                   select count(a.ne_numdoc) as totdocuti  from tbm_cabmovinv as a
                    where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc
                    and a.ne_numdoc between x.ne_numdocdes and x.ne_numdochas
               )
             end end   as totdocuti





  , case when x.co_grptipdoc = 4 then
               (
                select ( x.ne_numdochas - ultdocuti ) as totdocsob from (
                select max(a.ne_numdoc) as ultdocuti  from tbm_cabguirem as a
                INNER JOIN tbr_bodEmpBodGrp AS a6 ON (a6.co_emp=a.co_emp AND a6.co_bod=a.co_ptopar)
                where  ( a6.co_empGrp=0 AND a6.co_bodGrp=( x.co_bodgrp ) ) and a.ne_numdoc between x.ne_numdocdes and x.ne_numdochas
               ) as xx1
               )
            else case when x.co_grptipdoc = 5 then
            (

                 select ( x.ne_numdochas - ultdocuti ) as totdocsob from (
                 select  max(a.ne_numdoc1) as ultdocuti  from tbm_cabpag as a
                 where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc
                 and a.ne_numdoc1 between x.ne_numdocdes and x.ne_numdochas
                  ) as xx1
               )
            else
            (
                  select  ( x.ne_numdochas - ultdocuti ) as totdocsob from (
                    select max(a.ne_numdoc) as ultdocuti from tbm_cabmovinv as a
                    where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc
                    and a.ne_numdoc between x.ne_numdocdes and x.ne_numdochas
                      ) as xx1
               )
             end end   as totdocsob









  , case when x.co_grptipdoc = 4 then
               (
                select  (fechas-fecdes) as dias from (
                select min(a.fe_doc) as fecdes, max(a.fe_doc) as fechas  from tbm_cabguirem as a
                INNER JOIN tbr_bodEmpBodGrp AS a6 ON (a6.co_emp=a.co_emp AND a6.co_bod=a.co_ptopar)
                where  ( a6.co_empGrp=0 AND a6.co_bodGrp=( x.co_bodgrp ) ) and a.ne_numdoc between x.ne_numdocdes and x.ne_numdochas
               ) as xx1
               )
            else case when x.co_grptipdoc = 5 then
            (

                select  (fechas-fecdes) as dias from (
                 select min(a.fe_doc) as fecdes, max(a.fe_doc) as fechas from tbm_cabpag as a
                 where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc
                 and a.ne_numdoc1 between x.ne_numdocdes and x.ne_numdochas
                  ) as xx1
               )
            else
            (

                   select  (fechas-fecdes) as dias from (
                    select min(a.fe_doc) as fecdes, max(a.fe_doc) as fechas from tbm_cabmovinv as a
                    where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc
                    and a.ne_numdoc between x.ne_numdocdes and x.ne_numdochas
                      ) as xx1
               )
             end end   as dias



from (
select x.co_grptipdoc, x.co_bodgrp, a.co_emp, a.co_loc, a.co_tipdoc, a.ne_numdocdes, a.ne_numdochas, a.tx_feccadfac from (
select a.co_emp, a.co_loc,  a1.co_tipdoc, a.co_grptipdoc, a4.co_bodgrp
       from tbm_cabGrpTipDoc as a
      inner join tbm_cabTipDoc as a1 on (a1.co_emp=a.co_emp and a1.co_loc=a.co_loc and a1.co_grptipdoc=a.co_grptipdoc  )
       inner join tbm_loc as a2 on (a2.co_Emp=a1.co_emp and a2.co_loc=a1.co_loc)
       inner join tbm_emp as a5 on (a5.co_emp=a.co_emp )
        inner join tbr_bodloc as a3 on (a3.co_emp=a2.co_emp and a3.co_loc=a2.co_loc and a3.st_reg='P' )
        inner join tbr_bodEmpBodGrp as a4 on ( a4.co_emp=a3.co_emp and a4.co_bod=a3.co_bod )
       where a.st_forpreimp in ('A','N')  and a1.st_almdatautsri='S'
 and a.co_emp=$P{co_emp} and a.co_loc=$P{co_loc} and a1.co_tipdoc=$P{co_tipdoc}
       order by a.co_emp, a.co_loc, a1.co_tipdoc
) as x
inner join tbm_datautsri as a on(a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc )
) as x
ORDER BY x.ne_numdocdes]]>
	</queryString>
	<field name="co_grptipdoc" class="java.lang.Integer"/>
	<field name="co_bodgrp" class="java.lang.Integer"/>
	<field name="co_emp" class="java.lang.Integer"/>
	<field name="co_loc" class="java.lang.Integer"/>
	<field name="co_tipdoc" class="java.lang.Integer"/>
	<field name="ne_numdocdes" class="java.lang.Integer"/>
