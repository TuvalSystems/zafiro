			<staticText>
				<reportElement x="1" y="0" width="59" height="20"/>
				<textElement/>
				<text><![CDATA[Guayaquil,]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="1" y="278" width="534" height="187"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{st_mosparresp}.equals("S")? String.valueOf("Conocedor(a) de las penas de perjurio, declaro bajo juramento que el origen de los fondos de las transacciones bancarias que realice por este servicio a través del " + $F{tx_deslarbcoegr} + " no serán destinados a la realización o financiamiento de ninguna actividad ilícita. De igual manera, conociendo las disposiciones de Para Reprimir el Lavado de Activos, autorizo expresamente al " + $F{tx_deslarbcoegr} + " a realizar los análisis y verificaciones que considere necesarios; así como a las autoridades competentes en caso de llegar a determinar la existencia de operaciones y/o transacciones inusuales e injustificadas. En virtud de lo autorizado, renuncio a instaura por este motivo cualquier tipo de Acción Civil, Penal o Administrativa en contra del " + $F{tx_deslarbcoegr} + ". Eximo al " + $F{tx_deslarbcoegr} + " de toda responsabilidad, inclusive respecto a terceros si esta declaración fuese falsa o errónea, y me someto a las normas legales contempladas en Para Reprimir el Lavado de Activos."):(String.valueOf("\n\nSin otro particular, quedo de ustedes.\n\n\n\n Atentamente,\n\n\n\n\n      " + $F{tx_firaut1} + "                                " + ($F{st_fircon}.equals("S")?String.valueOf($F{tx_firaut2}):String.valueOf("") ) + "\n      " + $F{tx_carfiraut1} + "                             " + ($F{st_fircon}.equals("S")?String.valueOf($F{tx_carfiraut2}):String.valueOf("")) + " "))]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="2" y="242" width="533" height="28"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression class="java.lang.String"><![CDATA["El costo de la transferencia debitar de la " + $F{tx_tipctabanegr} + " de " + $F{tx_nomemp} + "."]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="2" y="167" width="533" height="60"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression class="java.lang.String"><![CDATA["Por medio de la presente, solicito se debite de nuestra " + $F{tx_tipctabanegr} + " No. " + $F{tx_numctabanegr} + " a nombre de " + $F{tx_nomemp} + " la cantidad de : "  + $F{tx_valtrapal} + " AMERICANOS(USD $" + $F{nd_valtra} + ") y a su vez nos transfieran a la " + $F{tx_tipctabaning} + " No. " + $F{tx_numctabaning} + " a nombre de " + $F{tx_nomprvloc} + " del " + $F{tx_deslarbcoing} + "."]]></textFieldExpression>
