<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafRptVeh07" language="groovy" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="co_emp" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="co_loc" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[4]]></defaultValueExpression>
	</parameter>
	<parameter name="co_tipDoc" class="java.lang.Integer"/>
	<parameter name="co_doc" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[2]]></defaultValueExpression>
	</parameter>
	<parameter name="strCamAudRpt" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[Campos de auditoria.
	strNomCla + strNomRpt + strUsr + strFecHorImp
strNomCla: Nombre de la clase desde la que se invoca al reporte
strNomRpt: Nombre del reporte
strUsr: Usuario que genera el reporte
strFecHorImp: Fecha y hora de impresión]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT a2.tx_desLar as tx_desLarVeh,
	        a2.tx_pla, (a5.tx_ape || ' ' ||a5.tx_nom) as nombre,
	        a4.tx_desLar as tx_desLarCom,a1.ne_kilAnt,a1.ne_kilAct,
	        ROUND(a1.nd_valDoc,2) as nd_valDoc,
	        a1.tx_obs1,a1.fe_doc,a1.ne_numDoc,
	        a6.tx_nom as tx_desLarEmp
FROM tbm_cabTicCom as a1
INNER JOIN tbm_veh as a2 ON (a1.co_veh=a2.co_veh)
INNER JOIN tbm_cabTipDoc as a3 ON (a1.co_tipDoc=a3.co_tipDoc)
INNER JOIN tbm_emp as a6 ON (a1.co_emp=a6.co_emp)
LEFT OUTER JOIN tbm_comVeh as a4 ON (a1.co_com=a4.co_com)
LEFT OUTER JOIN tbm_tra as a5 ON (a1.co_cho=a5.co_tra)
WHERE a1.co_doc=$P{co_doc} AND a1.co_emp=$P{co_emp} AND a1.co_loc=$P{co_loc} and
      a1.co_tipDoc=$P{co_tipDoc}]]>
	</queryString>
	<field name="tx_deslarveh" class="java.lang.String"/>
	<field name="tx_pla" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="tx_deslarcom" class="java.lang.String"/>
	<field name="ne_kilant" class="java.lang.Integer"/>
	<field name="ne_kilact" class="java.lang.Integer"/>
	<field name="nd_valdoc" class="java.math.BigDecimal"/>
	<field name="tx_obs1" class="java.lang.String"/>
	<field name="fe_doc" class="java.sql.Date"/>
	<field name="ne_numdoc" class="java.lang.Integer"/>
	<field name="tx_deslaremp" class="java.lang.String"/>
