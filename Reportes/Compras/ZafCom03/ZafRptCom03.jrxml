	<queryString>
		<![CDATA[select b.co_emp, b.co_loc, b.co_tipdoc, b.co_doc,  abs(b.nd_sub) as nd_sub ,abs(b.nd_sub) as nd_tot ,b.nd_valiva , b.co_cli
,b.tx_obs1
, emp.tx_desconesp as contri1 , tx_nomven, tx_desforpag , b.ne_numdoc , b.fe_doc
,emp.tx_nom, a1.tx_descor, a1.tx_deslar
from
tbm_cabmovinv as b
inner join tbm_cabtipdoc as a1 ON(a1.co_emp=b.co_emp and a1.co_loc=b.co_loc and a1.co_tipdoc=b.co_tipdoc)
inner JOIN tbm_emp as emp ON ( emp.co_emp = b.co_emp)
where
b.co_emp=$P{codEmp}
and b.co_loc=$P{codLoc}
and b.co_tipdoc=$P{codTipDoc}
and b.co_doc=$P{codDoc}
]]>
	</queryString>
