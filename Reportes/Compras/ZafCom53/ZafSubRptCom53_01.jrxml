<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafSubRptCom53_01" pageWidth="611" pageHeight="555" orientation="Landscape" columnWidth="611" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="co_doc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_emp" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_loc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_tipdoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="tx_nomclides" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[
select a.ne_numdoc, a1.tx_codalt, a1.tx_nomitm, a1.nd_can
,trim(a.tx_obs2) as obs2
,(
select sum(  (((case when x1.nd_pesitmkgr is null then 0 else x1.nd_pesitmkgr end *abs(x.nd_can)) *2.2)/100)  ) as kilo
from tbm_detguirem as x
INNER JOIN TBM_INV as x1 on (x1.co_emp=x.co_emp and x.co_itm=x1.co_itm)
where  x.co_emp = a.co_emp and x.co_loc= a.co_loc and x.co_tipdoc= a.co_tipdoc and x.co_doc = a.co_doc
) as pesotot
, case when ( trim(a.tx_obs2) is null or  trim(a.tx_obs2)='') then a1.tx_obs1 end  as docori
from tbm_cabguirem as a
inner join tbm_detguirem as a1 on (a1.co_emp=a.co_emp and a1.co_loc=a.co_loc and a1.co_tipdoc=a.co_tipdoc and a1.co_doc=a.co_doc )
where
a.co_emp = $P{co_emp}
and a.co_loc= $P{co_loc}
and a.co_tipdoc=  $P{co_tipdoc}
and a.co_doc =  $P{co_doc}
order by a1.co_reg]]>
	</queryString>
