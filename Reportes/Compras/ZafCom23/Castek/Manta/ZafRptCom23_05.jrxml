<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafRptCom23_05" pageWidth="611" pageHeight="399" columnWidth="567" leftMargin="14" rightMargin="14" topMargin="61" bottomMargin="28">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="co_emp" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_loc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_tipdoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_doc" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[select current_timestamp as feimpguia, *

,(
select ( 'Placa  :' ||  a2.tx_plavehretemprel )
from tbm_detguirem as a
inner join tbr_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
inner join tbm_detmovinv as a2 on (a2.co_emp=a1.co_emprel and a2.co_loc=a1.co_locrel and a2.co_tipdoc=a1.co_tipdocrel and a2.co_doc=a1.co_docrel and a2.co_reg=a1.co_regrel )
where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc and a.co_doc=x.co_doc and a.co_reg=x.co_reg and a2.tx_plavehretemprel is not null
group by a2.tx_plavehretemprel
) as placliret

,(
select ( 'Vehiculo  :' ||  a2.tx_vehretemprel )
from tbm_detguirem as a
inner join tbr_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
inner join tbm_detmovinv as a2 on (a2.co_emp=a1.co_emprel and a2.co_loc=a1.co_locrel and a2.co_tipdoc=a1.co_tipdocrel and a2.co_doc=a1.co_docrel and a2.co_reg=a1.co_regrel )
where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc and a.co_doc=x.co_doc and a.co_reg=x.co_reg and a2.tx_vehretemprel is not null
group by a2.tx_vehretemprel
) as vercliret


,(
select ( 'Persona Ret :' ||  a2.tx_perretemprel )
from tbm_detguirem as a
inner join tbr_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
inner join tbm_detmovinv as a2 on (a2.co_emp=a1.co_emprel and a2.co_loc=a1.co_locrel and a2.co_tipdoc=a1.co_tipdocrel and a2.co_doc=a1.co_docrel and a2.co_reg=a1.co_regrel )
where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc and a.co_doc=x.co_doc and a.co_reg=x.co_reg and a2.tx_perretemprel is not null
group by a2.tx_perretemprel
) as persocliret

,(
select ( 'Fecha :' ||  a2.fe_retemprel )
from tbm_detguirem as a
inner join tbr_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
inner join tbm_detmovinv as a2 on (a2.co_emp=a1.co_emprel and a2.co_loc=a1.co_locrel and a2.co_tipdoc=a1.co_tipdocrel and a2.co_doc=a1.co_docrel and a2.co_reg=a1.co_regrel )
where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc and a.co_doc=x.co_doc and a.co_reg=x.co_reg and a2.fe_retemprel is not null
group by a2.fe_retemprel
) as feccliret

 from (

select a1.ne_numorddes, a.tx_codalt, a.tx_nomitm,  a.nd_can ,a.co_regrel,  a.co_emp, a.co_loc, a.co_tipdoc, a.co_doc, a.co_reg
,(
select case when val is null then 0 else val end  from (
select sum(abs(x2.nd_can) ) as val from tbr_detmovinv as x
inner join tbr_detmovinv as x1 on (x1.co_emprel=x.co_emprel and x1.co_locrel=x.co_locrel and x1.co_tipdocrel=x.co_tipdocrel and x1.co_docrel=x.co_docrel and x1.co_regrel=x.co_regrel
and ( x1.co_emp!=x.co_emp or x1.co_loc!=x.co_loc or x1.co_tipdoc!=x.co_tipdoc or x1.co_doc!=x.co_doc )  )
inner join tbm_detmovinv as x2 on (x2.co_emp=x1.co_emp and x2.co_loc=x1.co_loc and x2.co_tipdoc=x1.co_tipdoc and x2.co_doc=x1.co_doc and x2.co_reg=x1.co_reg )
where x.co_emp=a.co_emprel and x.co_loc=a.co_locrel and x.co_tipdoc=a.co_tipdocrel and x.co_doc=a.co_docrel  and x.co_reg=a.co_regrel
and x2.st_cliretemprel='S' ) as x
) as canretcli
,(
select x3.tx_nom as bodret  from tbr_detmovinv as x
inner join tbr_detmovinv as x1 on (x1.co_emprel=x.co_emprel and x1.co_locrel=x.co_locrel and x1.co_tipdocrel=x.co_tipdocrel and x1.co_docrel=x.co_docrel and x1.co_regrel=x.co_regrel
and ( x1.co_emp!=x.co_emp or x1.co_loc!=x.co_loc or x1.co_tipdoc!=x.co_tipdoc or x1.co_doc!=x.co_doc )  )
inner join tbm_detmovinv as x2 on (x2.co_emp=x1.co_emp and x2.co_loc=x1.co_loc and x2.co_tipdoc=x1.co_tipdoc and x2.co_doc=x1.co_doc and x2.co_reg=x1.co_reg )
inner join tbm_bod as x3 on (x3.co_emp=x2.co_emp and x3.co_bod=x2.co_bod  )
where x.co_emp=a.co_emprel and x.co_loc=a.co_locrel and x.co_tipdoc=a.co_tipdocrel and x.co_doc=a.co_docrel  and x.co_reg=a.co_regrel
and x2.st_cliretemprel='S' group by x3.tx_nom
) as bodret



from tbm_detguirem as a
inner join tbm_cabguirem as a1 on (a1.co_emp=a.co_emp and a1.co_loc=a.co_loc and a1.co_tipdoc=a.co_tipdoc and a1.co_doc=a.co_doc )
where

a.co_emprel=$P{co_emp} and a.co_locrel=$P{co_loc} and a.co_tipdocrel=$P{co_tipdoc}
and a.co_docrel= $P{co_doc}


) as x where  canretcli  > 0]]>
	</queryString>
	<field name="feimpguia" class="java.sql.Timestamp"/>
	<field name="ne_numorddes" class="java.lang.Integer"/>
	<field name="tx_codalt" class="java.lang.String"/>
	<field name="tx_nomitm" class="java.lang.String"/>
	<field name="nd_can" class="java.math.BigDecimal"/>
	<field name="co_regrel" class="java.lang.Integer"/>
	<field name="co_emp" class="java.lang.Integer"/>
	<field name="co_loc" class="java.lang.Integer"/>
	<field name="co_tipdoc" class="java.lang.Integer"/>
	<field name="co_doc" class="java.lang.Integer"/>
	<field name="co_reg" class="java.lang.Integer"/>
	<field name="canretcli" class="java.math.BigDecimal"/>
	<field name="bodret" class="java.lang.String"/>
	<field name="placliret" class="java.lang.String"/>
	<field name="vercliret" class="java.lang.String"/>
	<field name="persocliret" class="java.lang.String"/>
	<field name="feccliret" class="java.lang.String"/>
