<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafRptCom23" pageWidth="595" pageHeight="608" columnWidth="567" leftMargin="14" rightMargin="14" topMargin="60" bottomMargin="28">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="co_emp" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_loc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_tipdoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_doc" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[select trim(DocCab.tx_obs2) as obs2,  DocCab.tx_numped, a3.tx_deslar, DocCab.fe_ing,  DocCab.tx_ptopar, a2.tx_obs1, DocCab.tx_nomven,  DocCab.tx_datdocoriguirem,


case when DocCab.co_emp=1 then
   case when DocCab.co_ptopar=1 then 'BCA' else
   case when DocCab.co_ptopar=2 then 'BNE' else
   case when DocCab.co_ptopar=3 then 'BIM' else
   case when DocCab.co_ptopar=4 then 'BDA' else
   case when DocCab.co_ptopar=5 then 'BCO' else
   case when DocCab.co_ptopar=6 then 'BEX' else
   case when DocCab.co_ptopar=7 then 'BVI' else
   case when DocCab.co_ptopar=8 then 'BQN' else
   case when DocCab.co_ptopar=9 then 'BQS' else
   case when DocCab.co_ptopar=10 then 'BMA'
end  end  end  end end  end  end  end END  END

ELSE case when DocCab.co_emp=2 then
   case when DocCab.co_ptopar=1 then 'BQ' else
   case when DocCab.co_ptopar=3 then 'BCA' else
   case when DocCab.co_ptopar=4 then 'BMA' else
   case when DocCab.co_ptopar=5 then 'BIM' else
   case when DocCab.co_ptopar=6 then 'BDA' else
   case when DocCab.co_ptopar=7 then 'BCO' else
   case when DocCab.co_ptopar=8 then 'BEX' else
   case when DocCab.co_ptopar=9 then 'BVI' else
   case when DocCab.co_ptopar=10 then 'BQS'
end  end  end  end end  end  end  end END

ELSE case when DocCab.co_emp=4 then
   case when DocCab.co_ptopar=1 then 'BVI' else
   case when DocCab.co_ptopar=2 then 'BCA' else
   case when DocCab.co_ptopar=3 then 'BIM' else
   case when DocCab.co_ptopar=4 then 'BDA' else
   case when DocCab.co_ptopar=5 then 'BCO' else
   case when DocCab.co_ptopar=6 then 'BEX' else
   case when DocCab.co_ptopar=7 then 'BQN' else
   case when DocCab.co_ptopar=8 then 'BQS' else
   case when DocCab.co_ptopar=9 then 'BMA'
end  end  end  end end  end  end  end END END

end
END as nombod,


case when DocCab.co_usring in (8) then 'AN' else
          case when DocCab.co_usring in (7) then 'PA' else
            case when DocCab.co_usring in (10) then 'MA' else
              case when DocCab.co_usring in (20) then 'NO'  end end end end as usr
,
DocCab.tx_telclides, DocCab.tx_rucclides,
DocCab.ne_numdoc, DocCab.fe_doc,

DocCab.tx_nomclides,DocCab.co_clides,  DocCab.tx_dirclides  /*,DocCab.tx_vehret, DocCab.tx_choret,  a3.tx_deslar, */
,

a2.tx_codalt

,


     CASE WHEN trim(a2.tx_nomitm)=trim(inv.tx_nomitm) THEN   a2.tx_nomitm
            ELSE a2.tx_nomitm || ' (**) '
       END

as tx_nomitm

, abs(a2.nd_can) as can, a2.tx_unimed,

ciu.tx_deslar as cuidad

, emp.tx_desconesp as contri1

, emp.tx_nom  as empresa
,
(select sum( (inv.nd_pesitmkgr*abs(x.nd_can)) ) as kgramo from tbm_detguirem as x
inner join tbm_inv as inv on(x.co_emp=inv.co_emp and x.co_itm=inv.co_itm)
WHERE x.co_emp=DocCab.co_emp and x.co_loc=DocCab.co_loc  and x.co_tipdoc=DocCab.co_tipdoc and x.co_doc=DocCab.co_doc ) as kgramo
,
(select sum( (((inv.nd_pesitmkgr*abs(x.nd_can))*2.2)/100)  ) as kilo from tbm_detguirem as x
inner join tbm_inv as inv on(x.co_emp=inv.co_emp and x.co_itm=inv.co_itm)
WHERE x.co_emp=DocCab.co_emp and x.co_loc=DocCab.co_loc  and x.co_tipdoc=DocCab.co_tipdoc and x.co_doc=DocCab.co_doc ) as kilo



FROM
tbm_cabguirem as DocCab
INNER JOIN tbm_detguirem as a2  ON(DocCab.co_emp=a2.co_emp and DocCab.co_loc=a2.co_loc
and DocCab.co_tipdoc=a2.co_tipdoc and DocCab.co_doc=a2.co_doc)
  LEFT OUTER JOIN tbm_var as a3 ON (a3.co_reg = DocCab.co_forret )
inner join tbm_inv as inv on(a2.co_emp=inv.co_emp and a2.co_itm=inv.co_itm)
inner JOIN tbm_loc as loc ON ( doccab.co_emp = loc.co_emp and  doccab.co_loc=loc.co_loc)
inner JOIN tbm_ciu as ciu ON ( loc.co_ciu = ciu.co_ciu)
inner JOIN tbm_emp as emp ON ( emp.co_emp = DocCab.co_emp)

WHERE
DocCab.co_emp=$P{co_emp}
and DocCab.co_loc=$P{co_loc}
and DocCab.co_tipdoc=$P{co_tipdoc}
and DocCab.co_doc=$P{co_doc}
order by a2.co_reg]]>
	</queryString>
