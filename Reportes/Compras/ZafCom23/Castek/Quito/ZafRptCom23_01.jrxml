<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafRptCom23_01" pageWidth="595" pageHeight="749" columnWidth="581" leftMargin="0" rightMargin="14" topMargin="60" bottomMargin="19">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="3.6363636363636362"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="480"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="co_emp" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="co_loc" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[4]]></defaultValueExpression>
	</parameter>
	<parameter name="co_tipdoc" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[101]]></defaultValueExpression>
	</parameter>
	<parameter name="co_doc" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[36958]]></defaultValueExpression>
	</parameter>
	<parameter name="nomUsrImp" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["/home/sistemas1/Zafiro_escritorio/Reportes/Compras/ZafCom23/Tuval/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select *,
       case when placliret is null then(
	       select ( 'Placa  :' ||  a2.tx_plavehretemprel )
	       from tbm_detguirem as a
	       inner join tbr_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
	       inner join tbm_detmovinv as a2 on (a2.co_emp=a1.co_emprel and a2.co_loc=a1.co_locrel and a2.co_tipdoc=a1.co_tipdocrel and a2.co_doc=a1.co_docrel and a2.co_reg=a1.co_regrel )
	       where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc and a.co_doc=x.co_doc and a.co_reg=x.co_reg and a2.tx_plavehretemprel is not null
	       group by a2.tx_plavehretemprel)
       else null
       end as placliret2,
       case when vercliret is null then(
	       select ( 'Vehiculo  :' ||  a2.tx_vehretemprel )
	       from tbm_detguirem as a
	       inner join tbr_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
	       inner join tbm_detmovinv as a2 on (a2.co_emp=a1.co_emprel and a2.co_loc=a1.co_locrel and a2.co_tipdoc=a1.co_tipdocrel and a2.co_doc=a1.co_docrel and a2.co_reg=a1.co_regrel )
	       where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc and a.co_doc=x.co_doc and a.co_reg=x.co_reg and a2.tx_vehretemprel is not null
	       group by a2.tx_vehretemprel)
       else null
       end as vercliret2,
       case when persocliret is null then(
       select ( 'Persona Ret :' ||  a2.tx_perretemprel )
       from tbm_detguirem as a
       inner join tbr_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
       inner join tbm_detmovinv as a2 on (a2.co_emp=a1.co_emprel and a2.co_loc=a1.co_locrel and a2.co_tipdoc=a1.co_tipdocrel and a2.co_doc=a1.co_docrel and a2.co_reg=a1.co_regrel )
       where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc and a.co_doc=x.co_doc and a.co_reg=x.co_reg and a2.tx_perretemprel is not null
       group by a2.tx_perretemprel)
       else null
       end as persocliret2,
       case when feccliret is null then(
       select ( 'Fecha :' ||  a2.fe_retemprel )
       from tbm_detguirem as a
       inner join tbr_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
       inner join tbm_detmovinv as a2 on (a2.co_emp=a1.co_emprel and a2.co_loc=a1.co_locrel and a2.co_tipdoc=a1.co_tipdocrel and a2.co_doc=a1.co_docrel and a2.co_reg=a1.co_regrel )
       where a.co_emp=x.co_emp and a.co_loc=x.co_loc and a.co_tipdoc=x.co_tipdoc and a.co_doc=x.co_doc and a.co_reg=x.co_reg and a2.fe_retemprel is not null
       group by a2.fe_retemprel)
       else null
       end as feccliret2,
       case when co_ptopar =15 then 'INMACONSA' else '' end as puntoPartida
from ( select
       DocCab.co_emp,
       DocCab.co_loc,
       DocCab.co_tipdoc,
       DocCab.co_doc,
       a2.co_reg,
       current_timestamp as feimpguia,
       DocCab.fe_ing, a2.tx_obs1,
       trim(DocCab.tx_obs2) as obs2,
       DocCab.tx_numped,
       emp.tx_nom,
       tipdoc.tx_descor,
       DocCab.fe_ing,
       DocCab.tx_datdocoriguirem,
       DocCab.co_ptopar,
       DocCab.tx_ptopar,
       emp.tx_nom  as empresa,
       DocCab.tx_telclides,
       DocCab.tx_rucclides,
       DocCab.ne_numorddes,
       DocCab.fe_doc,
       DocCab.tx_nomclides,
       DocCab.co_clides,
       DocCab.tx_nomven,
       DocCab.tx_dirclides,
       DocCab.tx_vehret,
       DocCab.tx_choret,
       a3.tx_deslar,
       invbod.tx_ubi,
       invbod.st_impord,
        /*inv.tx_codalt2,*/
       (substring(inv.tx_codalt2 from 1 for 1 ) || ' ' || substring(inv.tx_codalt2 from 2 for 1 ) || ' ' || substring(inv.tx_codalt2 from 3 for  1 )) as tx_codalt2,
       case when invbod.st_impOrd='N' then
		case when substr(a2.tx_codalt, char_length(a2.tx_codalt),1) = 'L' then
			case when a1.st_meringegrfisbod='A' then
				'********'
			else
				a2.tx_codalt
			end
		else
			a2.tx_codalt
		end
       else
		null
	end as tx_codalt,
        case when substr(a2.tx_codalt, char_length(a2.tx_codalt),1) = 'L' then
			case when a1.st_meringegrfisbod='A' then
				'********'
			else
				inv.tx_nomitm
			end

	else
		CASE WHEN trim(inv.tx_nomitm)=trim(inv.tx_nomitm) THEN
			inv.tx_nomitm
		ELSE
			' (**) ' || inv.tx_nomitm
		END
	END as tx_nomitm, --CASE WHEN trim(inv.tx_nomitm)=trim(inv.tx_nomitm) THEN inv.tx_nomitm ELSE inv.tx_nomitm || ' (**) ' END as tx_nomitm,
       case when substr(a2.tx_codalt, char_length(a2.tx_codalt),1) = 'L' then
		case when a1.st_meringegrfisbod='A' then
			 0
		else
			abs(a2.nd_can)
		end
	else
		abs(a2.nd_can)
	end as can,
        case when substr(a2.tx_codalt, char_length(a2.tx_codalt),1) = 'L' then
		case when a1.st_meringegrfisbod='A' then
 			0
		else
			ROUND(abs(a1.nd_canpen),2)
		end
        else
		ROUND(abs(a1.nd_canpen),2)
	END  as canPen,
       case when substr(a2.tx_codalt, char_length(a2.tx_codalt),1) = 'L' then
		case when a1.st_meringegrfisbod='A' then
			'********'
		else
			a2.tx_unimed
		end
	else
		a2.tx_unimed
	end as tx_unimed,
       DocCab.tx_ciuclides as cuidad,
       emp.tx_desconesp as contri1,
       emp.tx_nom  as empresa,
       (select sum( (inv.nd_pesitmkgr*abs(x.nd_can)) ) as kgramo from tbm_detguirem as x inner join tbm_inv as inv on(x.co_emp=inv.co_emp and x.co_itm=inv.co_itm) WHERE x.co_emp=DocCab.co_emp and x.co_loc=DocCab.co_loc  and x.co_tipdoc=DocCab.co_tipdoc and x.co_doc=DocCab.co_doc ) as kgramo,
       (select sum( (((inv.nd_pesitmkgr*abs(x.nd_can))*2.2)/100)  ) as kilo from tbm_detguirem as x inner join tbm_inv as inv on(x.co_emp=inv.co_emp and x.co_itm=inv.co_itm) WHERE x.co_emp=DocCab.co_emp and x.co_loc=DocCab.co_loc  and x.co_tipdoc=DocCab.co_tipdoc and x.co_doc=DocCab.co_doc ) as kilo,
       case when a1.st_cliretemprel='S' then '(CR)' else null end as estcliret,
       (select a1.tx_obscliretemprel from tbm_detguirem as a
        inner join tbm_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
        where a.co_emp=DocCab.co_emp and a.co_loc=DocCab.co_loc and a.co_tipdoc=DocCab.co_tipdoc and a.co_doc=DocCab.co_doc and a1.st_cliretemprel is not null
        group by a1.tx_obscliretemprel) as obscliret,
       (select ( 'Fecha :' ||  a1.fe_retemprel ) from tbm_detguirem as a
        inner join tbm_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
        where a.co_emp=DocCab.co_emp and a.co_loc=DocCab.co_loc and a.co_tipdoc=DocCab.co_tipdoc and a.co_doc=DocCab.co_doc and a1.fe_retemprel is not null
        group by a1.fe_retemprel) as feccliret,
       (select ( 'Persona Ret :' ||  a1.tx_perretemprel ) from tbm_detguirem as a
        inner join tbm_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
        where a.co_emp=DocCab.co_emp and a.co_loc=DocCab.co_loc and a.co_tipdoc=DocCab.co_tipdoc and a.co_doc=DocCab.co_doc and a1.tx_perretemprel is not null
        group by a1.tx_perretemprel ) as persocliret,
       (select  ( 'Vehiculo :' || a1.tx_vehretemprel ) from tbm_detguirem as a
        inner join tbm_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
        where a.co_emp=DocCab.co_emp and a.co_loc=DocCab.co_loc and a.co_tipdoc=DocCab.co_tipdoc and a.co_doc=DocCab.co_doc and a1.tx_vehretemprel is not null
        group by a1.tx_vehretemprel) as vercliret,
       (select ( 'Placa :' ||  a1.tx_plavehretemprel ) from tbm_detguirem as a
        inner join tbm_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
        where a.co_emp=DocCab.co_emp and a.co_loc=DocCab.co_loc and a.co_tipdoc=DocCab.co_tipdoc and a.co_doc=DocCab.co_doc and a1.tx_plavehretemprel is not null
        group by a1.tx_plavehretemprel) as placliret
,CASE WHEN a2.co_tipDocRel IN (1,228,124,238,127,242,125,126,166,225,206,153,58,96,97,98) THEN 'VENTA' ELSE CASE WHEN a2.co_tipDocRel IN (4,46,172,204,234) THEN 'REPOSICIÓN' END END AS  tipDocRelOri,Round(detcot.nd_canloc,2) as nd_canloc,  bod.tx_nom as bodega_origen , boddes.tx_nom  as bodega_destino , doccab.fe_ultmod
       FROM tbm_cabguirem as DocCab
       INNER JOIN tbm_detguirem as a2  ON(DocCab.co_emp=a2.co_emp and DocCab.co_loc=a2.co_loc and DocCab.co_tipdoc=a2.co_tipdoc and DocCab.co_doc=a2.co_doc)
       inner join tbm_detmovinv as a1 on (a1.co_emp=a2.co_emprel and a1.co_loc=a2.co_locrel and a1.co_tipdoc=a2.co_tipdocrel and a1.co_doc=a2.co_docrel and a1.co_reg=a2.co_regrel )
       LEFT OUTER JOIN tbm_var as a3 ON (DocCab.co_forret = a3.co_reg )
       inner join tbm_inv as inv on(a2.co_emp=inv.co_emp and a2.co_itm=inv.co_itm)
       inner JOIN tbm_loc as loc ON ( doccab.co_emp = loc.co_emp and  doccab.co_loc=loc.co_loc)
       inner JOIN tbm_ciu as ciu ON ( loc.co_ciu = ciu.co_ciu)
       inner JOIN tbm_emp as emp ON ( emp.co_emp = DocCab.co_emp)
       inner JOIN tbm_cabtipdoc as tipdoc ON ( tipdoc.co_emp = DocCab.co_emp and tipdoc.co_loc=DocCab.co_loc and tipdoc.co_tipdoc=DocCab.co_tipdoc)
       inner join tbm_invbod as invbod on(a2.co_emp=invbod.co_emp and a2.co_itm=invbod.co_itm and DocCab.co_ptopar=invbod.co_bod)
       inner join tbm_cabmovinv as cab on (cab.co_emp=a1.co_emp and cab.co_loc=a1.co_loc and cab.co_tipdoc=a1.co_tipdoc and cab.co_doc=a1.co_doc)
       left outer join tbm_cabcotven as cot on (cot.co_emp=cab.co_emp and cot.co_loc=cab.co_loc and cot.co_cot=cab.ne_numcot)
left outer join tbm_detcotven as detcot on (cot.co_emp= detcot.co_emp and cot.co_loc=detcot.co_loc and cot.co_cot=detcot.co_cot and detcot.co_emp=a1.co_emp and detcot.co_loc=a1.co_loc and detcot.co_reg=a1.co_reg)
inner join tbm_bod as bod on ( DocCab.co_emp= bod.co_emp and DocCab.co_ptopar=bod.co_bod)
       left outer join tbm_cabsoltrainv sol on (sol.co_emp=cab.co_emprelcabsoltrainv and sol.co_loc=cab.co_locrelcabsoltrainv and sol.co_tipdoc=cab.co_tipdocrelcabsoltrainv and sol.co_doc=co_docrelcabsoltrainv)
       left outer join tbm_bod as boddes on (boddes.co_emp=0  and boddes.co_bod=sol.co_boddes)

       WHERE DocCab.co_emp=$P{co_emp}
       and DocCab.co_loc=$P{co_loc}
       and DocCab.co_tipdoc=$P{co_tipdoc}
       and DocCab.co_doc=$P{co_doc}


    ) as x
order by case when tx_ubi = '' then null else tx_ubi end, co_reg]]>
	</queryString>
