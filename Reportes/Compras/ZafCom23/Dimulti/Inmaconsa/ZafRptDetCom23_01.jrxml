<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafRptCom23_01" pageWidth="595" pageHeight="608" columnWidth="581" leftMargin="0" rightMargin="14" topMargin="0" bottomMargin="0">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="3.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="co_emp" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_loc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_tipdoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_doc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="co_reg" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[select * from (
select a5.tx_nom , abs( sum(a4.nd_can) ) as canegr , CASE WHEN a4.st_cliretemprel IN ('S') then 'Cliente Retira ' else '' end as cliret from tbm_detguirem as a
inner join  tbm_Cabguirem as cab
on (a.co_emp=cab.co_emp and a.co_loc=cab.co_loc and a.co_tipdoc=cab.co_tipdoc and a.co_doc=cab.co_doc)
inner join tbm_detmovinv as a1 on (a1.co_emp=a.co_emprel and a1.co_loc=a.co_locrel and a1.co_tipdoc=a.co_tipdocrel and a1.co_doc=a.co_docrel and a1.co_reg=a.co_regrel )
inner join tbr_detmovinv as a2 on (a2.co_emp=a1.co_emp and a2.co_loc=a1.co_loc and a2.co_tipdoc=a1.co_tipdoc and a2.co_doc=a1.co_doc and a2.co_reg=a1.co_reg )
inner join tbr_detmovinv as a3 on (a3.co_emprel=a2.co_emprel and a3.co_locrel=a2.co_locrel and a3.co_tipdocrel=a2.co_tipdocrel and a3.co_docrel=a2.co_docrel and a3.co_regrel=a2.co_regrel
and ((a3.co_tipdoc=228 and ((a3.co_emp=1 and a3.co_loc=11) or (a3.co_emp=4 and a3.co_loc=11) or (a3.co_emp=2 and a3.co_loc=5))) or a3.co_tipdoc in(153,206)))
inner join tbm_detmovinv as a4 on (a4.co_emp=a3.co_emp and a4.co_loc=a3.co_loc and a4.co_tipdoc=a3.co_tipdoc and a4.co_doc=a3.co_doc and a4.co_reg=a3.co_reg )
inner join tbm_bod as a5 on (a5.co_emp=a4.co_emp and a5.co_bod=a4.co_bod )
inner join tbm_bod as a6 on (a6.co_emp=a1.co_emp and a6.co_bod=a1.co_bod )
WHERE
a.co_emp=$P{co_emp}
and a.co_loc=$P{co_loc}
and a.co_tipdoc=$P{co_tipdoc}
and a.co_doc=$P{co_doc}
and a.co_reg=$P{co_reg} and a.co_tipdocrel IN (1,228,294)
and cab.co_ptodes is null
group by a6.tx_nom, a1.nd_can, a5.tx_nom, a4.st_cliretemprel
) as x where canegr > 0


union


select bod.tx_nom ,ped.nd_can as canegr, '' as cliret
from tbm_cabguirem as c
inner join tbm_detguirem as d
on (c.co_emp=d.co_emp and c.co_loc=d.co_loc and c.co_tipdoc=d.co_tipdoc and c.co_doc=d.co_doc)
inner join tbm_detmovinv as a1
on (a1.co_emp=d.co_emprel and a1.co_loc=d.co_locrel and a1.co_tipdoc=d.co_tipdocrel and a1.co_doc=d.co_docrel and a1.co_reg=d.co_regrel )
inner join tbm_cabmovinv as a2
on (a1.co_emp=a2.co_emp and a1.co_loc=a2.co_loc and a1.co_tipdoc=a2.co_tipdoc and a1.co_doc=a2.co_doc)
inner join tbm_detcotven detcot
on(detcot.co_emp=a2.co_emp and detcot.co_loc=a2.co_loc and detcot.co_cot=a2.ne_numcot and detcot.co_itm=d.co_itm)
inner join tbr_detcotven as detcotr
on (detcotr.co_emp=detcot.co_emp and detcotr.co_loc=detcot.co_loc and detcotr.co_cot=detcot.co_cot and detcotr.co_reg=detcot.co_reg)
inner join tbm_pedOtrBodCOtVen as ped
on (detcotr.co_emprel= ped.co_emp and detcotr.co_locrel=ped.co_loc and detcotr.co_cotrel=ped.co_cot and detcotr.co_regrel=ped.co_reg and ped.st_pedotrbod='S')
inner join tbm_bod as bod
on (bod.co_emp=ped.co_emprel and bod.co_bod=ped.co_bodrel)
where
d.co_emp=$P{co_emp}
and d.co_loc=$P{co_loc}
and d.co_tipdoc=$P{co_tipdoc}
and d.co_doc=$P{co_doc}
and d.co_reg=$P{co_reg}]]>
	</queryString>
	<field name="tx_nom" class="java.lang.String"/>
	<field name="canegr" class="java.math.BigDecimal"/>
	<field name="cliret" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="11" splitType="Stretch">
			<textField pattern="" isBlankWhenNull="true">
				<reportElement key="textField-30" mode="Transparent" x="1" y="0" width="55" height="11" forecolor="#000000" backcolor="#FFFFFF"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Top" rotation="None" lineSpacing="Single">
					<font fontName="SansSerif" size="8" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfFontName="Helvetica" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{tx_nom}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
				<reportElement key="textField-35" mode="Transparent" x="57" y="0" width="40" height="11" forecolor="#000000" backcolor="#FFFFFF"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement verticalAlignment="Top" rotation="None" lineSpacing="Single">
					<font fontName="SansSerif" size="8" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfFontName="Helvetica" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{canegr}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="103" y="0" width="51" height="11"/>
				<textElement>
					<font size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{cliret}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band splitType="Stretch"/>
	</pageFooter>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
