<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ZafRptCom23" pageWidth="614" pageHeight="609" columnWidth="590" leftMargin="14" rightMargin="10" topMargin="30" bottomMargin="27">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="co_emp" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="co_loc" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[4]]></defaultValueExpression>
	</parameter>
	<parameter name="co_tipdoc" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[101]]></defaultValueExpression>
	</parameter>
	<parameter name="co_doc" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[36959]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select case when inv.nd_pesitmkgr is null then '(P0)' else case  when inv.nd_pesitmkgr <= 0 then '(P0)' else '' end end as tiepes,
DocCab.fe_initra, DocCab.fe_tertra,
(
select ( x5.tx_descor || '     ' || x4.tx_numautsri ) as NumSri from tbm_cabguirem as x
inner join tbr_cabguirem as x1 on (x1.co_emp=x.co_emp and x1.co_loc=x.co_loc and x1.co_tipdoc=x.co_tipdoc and x1.co_doc=x.co_doc )
inner join tbm_detguirem as x2 on (x2.co_emp=x1.co_emp and x2.co_loc=x1.co_locrel and x2.co_tipdoc=x1.co_tipdocrel and x2.co_doc=x1.co_docrel )
inner join tbm_cabmovinv as x3 on (x3.co_emp=x2.co_emprel and x3.co_loc=x2.co_locrel and x3.co_tipdoc=x2.co_tipdocrel and x3.co_doc=x2.co_docrel )
inner join tbm_datautsri as x4 on (x4.co_emp=x3.co_emp and x4.co_loc=x3.co_loc and x4.co_tipdoc=x3.co_tipdoc )
inner join tbm_cabtipdoc as x5 on (x5.co_emp=x4.co_emp and x5.co_loc=x4.co_loc and x5.co_tipdoc=x4.co_tipdoc )
where x.co_emp=DocCab.co_emp and x.co_loc=DocCab.co_loc and x.co_tipdoc=DocCab.co_tipdoc and x.co_doc= DocCab.co_doc
and x3.ne_numdoc between x4.ne_numdocdes and x4.ne_numdochas
group by x5.tx_descor, x4.tx_numautsri
) as NumSri,
DocCab.fe_ing,
a2.tx_obs1,
trim(DocCab.tx_obs2) as obs2,
case when DocCab.tx_numped is null then '' else DocCab.tx_numped end as tx_numped,
emp.tx_nom, tipdoc.tx_descor,
DocCab.fe_ing,
DocCab.tx_datdocoriguirem,
DocCab.co_ptopar,
DocCab.tx_ptopar,
case when DocCab.co_ptopar =15 then 'INMACONSA' else '' end as puntopartida,
emp.tx_nom  as empresa,
DocCab.tx_telclides,
DocCab.tx_rucclides,
DocCab.ne_numdoc,
DocCab.fe_doc,
DocCab.tx_nomclides,
DocCab.co_clides,
DocCab.tx_nomven,
DocCab.tx_dirclides,
DocCab.tx_vehret,
DocCab.tx_choret,
a3.tx_deslar,
a2.tx_codalt,
CASE WHEN trim(a2.tx_nomitm)=trim(inv.tx_nomitm) THEN a2.tx_nomitm ELSE a2.tx_nomitm || ' (**) ' END as tx_nomitm,
abs(a2.nd_can) as can,
a2.tx_unimed,
DocCab.tx_ciuclides as cuidad,
emp.tx_desconesp as contri1,
emp.tx_nom  as empresa,
(select sum( (inv.nd_pesitmkgr*abs(x.nd_can)) ) as kgramo from tbm_detguirem as x
inner join tbm_inv as inv on(x.co_emp=inv.co_emp and x.co_itm=inv.co_itm)
WHERE x.co_emp=DocCab.co_emp and x.co_loc=DocCab.co_loc  and x.co_tipdoc=DocCab.co_tipdoc and x.co_doc=DocCab.co_doc ) as kgramo,
(select sum( (((inv.nd_pesitmkgr*abs(x.nd_can))*2.2)/100)  ) as kilo from tbm_detguirem as x
inner join tbm_inv as inv on(x.co_emp=inv.co_emp and x.co_itm=inv.co_itm)
WHERE x.co_emp=DocCab.co_emp and x.co_loc=DocCab.co_loc  and x.co_tipdoc=DocCab.co_tipdoc and x.co_doc=DocCab.co_doc ) as kilo,
CASE WHEN veh.tx_pla isnull THEN DocCab.tx_idetra ELSE tra.tx_ide END AS tx_idetra,
CASE WHEN veh.tx_pla isnull THEN DocCab.tx_nomtra ELSE tra.tx_nom || ' ' || tra.tx_ape END AS tx_nomtra,
CASE WHEN veh.tx_pla isnull THEN DocCab.tx_plavehtra ELSE veh.tx_pla END AS tx_plaveh
FROM tbm_cabguirem as DocCab
INNER JOIN tbm_detguirem as a2 ON (DocCab.co_emp=a2.co_emp and DocCab.co_loc=a2.co_loc and DocCab.co_tipdoc=a2.co_tipdoc and DocCab.co_doc=a2.co_doc)
LEFT OUTER JOIN tbm_var as a3 ON (DocCab.co_forret = a3.co_reg )
inner join tbm_inv as inv on(a2.co_emp=inv.co_emp and a2.co_itm=inv.co_itm)
inner JOIN tbm_loc as loc ON ( doccab.co_emp = loc.co_emp and  doccab.co_loc=loc.co_loc)
inner JOIN tbm_ciu as ciu ON ( loc.co_ciu = ciu.co_ciu)
inner JOIN tbm_emp as emp ON ( emp.co_emp = DocCab.co_emp)
inner JOIN tbm_cabtipdoc as tipdoc ON ( tipdoc.co_emp = DocCab.co_emp and tipdoc.co_loc=DocCab.co_loc and tipdoc.co_tipdoc=DocCab.co_tipdoc)
LEFT JOIN tbm_veh as veh on (veh.co_veh = DocCab.co_veh)
LEFT JOIN tbm_tra as tra on (tra.co_tra = DocCab.co_cho)
WHERE DocCab.co_emp=$P{co_emp}
and DocCab.co_loc=$P{co_loc}
and DocCab.co_tipdoc=$P{co_tipdoc}
and DocCab.co_doc=$P{co_doc}
order by a2.co_reg]]>
	</queryString>
