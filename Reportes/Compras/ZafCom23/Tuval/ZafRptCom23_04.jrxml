				<reportElement key="staticText-1" mode="Transparent" x="123" y="1" width="54" height="11" forecolor="#000000" backcolor="#FFFFFF"/>
				<box>
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
