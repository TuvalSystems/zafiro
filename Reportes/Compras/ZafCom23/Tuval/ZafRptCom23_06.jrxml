	<queryString>
		<![CDATA[select current_timestamp as feimpguia, a1.ne_numorddes, a.tx_codalt, a.tx_nomitm, a.nd_can, a.co_regrel, a.co_emp, a.co_loc, a.co_tipdoc, a.co_doc, a.co_reg, a2.ne_numdoc, abs(nd_can) as canretcli
from tbm_detguirem as a
inner join tbm_cabguirem as a1 on (a1.co_emp=a.co_emp and a1.co_loc=a.co_loc and a1.co_tipdoc=a.co_tipdoc and a1.co_doc=a.co_doc )
inner join tbm_cabmovinv as a2 on (a.co_emprel=a2.co_emp and a.co_locrel=a2.co_loc and a.co_tipdocrel=a2.co_tipdoc and a.co_docrel=a2.co_doc )
where a.co_emprel=$P{co_emp}
and a.co_locrel=$P{co_loc}
and a.co_tipdocrel=$P{co_tipdoc}
and a.co_docrel=$P{co_doc}]]>
	</queryString>
