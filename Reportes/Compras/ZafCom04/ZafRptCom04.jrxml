	<parameter name="codLoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="codTipDoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="codDoc" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\Zafiro_escritorio\\Reportes\\Compras\\ZafCom04\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select b.co_emp, b.co_loc, b.co_tipdoc, b.co_doc,  emp.tx_nom as empresa, b.ne_numdoc, b.fe_Doc, b.ne_numcot,
abs(b.nd_sub) as sub, abs(b.nd_tot) as total,abs(b.nd_valiva) as valiva , b.co_cli , cli.tx_tel as tel, cli.tx_ide as ruc,cli.tx_dir,cli.co_cli as cocli ,cli.tx_nom as nomcli
,b.tx_obs1
, emp.tx_desconesp as contri1
from tbm_cabmovinv as b
inner join tbm_cli as cli on(b.co_emp=cli.co_emp and b.co_cli=cli.co_cli)
inner JOIN tbm_emp as emp ON ( emp.co_emp = b.co_emp)
where
b.co_emp = $P{codEmp}
and b.co_loc = $P{codLoc}
and b.co_tipdoc =  $P{codTipDoc}
and b.co_doc = $P{codDoc}]]>
	</queryString>
