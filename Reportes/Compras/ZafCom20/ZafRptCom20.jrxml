<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RptZafCom20" pageWidth="595" pageHeight="608" columnWidth="567" leftMargin="14" rightMargin="14" topMargin="34" bottomMargin="28">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="0.75"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="coDoc" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="coEmp" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="coLoc" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="coTipDoc" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="coEmpTra" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
coEmpTra, coLocTra, coTipDocTra, coDocTra, ne_numdoc, fe_Doc, bod1, nombod1,  bod2, nombod2,  kgramo, kilo,

tx_nom, tx_ruc,
a2.tx_codalt2, a2.tx_nomitm ,
  a2.tx_unimed ,abs(a2.nd_can) as can
, x3.tx_obs1
FROM (

SELECT
coEmpTra, coLocTra, coTipDocTra, coDocTra,  ne_numdoc, fe_Doc, bod1, a4.tx_nom as nombod1,  bod2, a5.tx_nom as nombod2,  kgramo, kilo
,a3.tx_nom, a3.tx_ruc, x2.tx_obs1  /*a2.tx_dir, a4.tx_deslar, a2.tx_tel */
FROM (
SELECT coEmpTra, coLocTra, coTipDocTra, coDocTra, ne_numdoc, fe_Doc, bod1, bod2, kgramo, kilo, x1.tx_obs1
--,a2.tx_dir as punpar


FROM (
SELECT a.co_emp AS coEmpTra , a.co_loc AS coLocTra , a.co_tipdoc AS coTipDocTra, a.co_Doc AS coDocTra ,  a.ne_numdoc, a.fe_Doc,
( SELECT distinct(co_bod) FROM tbm_detmovinv as b1 WHERE b1.co_emp=a.co_emp AND b1.co_loc=a.co_loc AND b1.co_tipdoc=a.co_tipdoc AND b1.co_doc=a.co_doc AND b1.nd_can<0 )
 AS bod1
,( SELECT distinct(co_bod) FROM tbm_detmovinv as b1 WHERE b1.co_emp=a.co_emp AND b1.co_loc=a.co_loc AND b1.co_tipdoc=a.co_tipdoc AND b1.co_doc=a.co_doc AND b1.nd_can>0 )
 AS bod2
,( SELECT sum((inv.nd_pesitmkgr*abs(b3.nd_can))) as kgramo FROM tbm_detmovinv as b3
  INNER JOIN tbm_inv AS inv ON(inv.co_emp=b3.co_emp AND inv.co_itm=b3.co_itm)
  WHERE b3.co_emp=a.co_emp AND b3.co_loc=a.co_loc AND b3.co_tipdoc=a.co_tipdoc AND b3.co_doc=a.co_doc AND b3.nd_can>0 )
 AS kgramo

,( SELECT sum((((inv.nd_pesitmkgr*abs(b3.nd_can))*2.2)/100)) as kilo FROM tbm_detmovinv as b3
  INNER JOIN tbm_inv AS inv ON(inv.co_emp=b3.co_emp AND inv.co_itm=b3.co_itm)
  WHERE b3.co_emp=a.co_emp AND b3.co_loc=a.co_loc AND b3.co_tipdoc=a.co_tipdoc AND b3.co_doc=a.co_doc AND b3.nd_can>0 )
 AS kilo
, a.tx_obs1
FROM tbm_cabMovInv AS a
WHERE a.co_emp=$P{coEmp}
and a.co_loc=$P{coLoc}
and a.co_tipdoc=$P{coTipDoc}
and a.co_doc=$P{coDoc}

) AS x1
    INNER JOIN tbm_bod AS a2 ON (a2.co_emp=x1.coEmpTra AND a2.co_bod=x1.bod1 )

) AS x2
   -- LEFT JOIN tbm_loc AS a2 ON (a2.co_emp=x2.codEmpEnvTra AND a2.co_loc=x2.codLocEnvTra )
    LEFT JOIN tbm_emp AS a3 ON (a3.co_emp=x2.coEmpTra)
     LEFT JOIN tbm_bod AS a4 ON(a4.co_emp=x2.coEmpTra and a4.co_bod=x2.bod1 )
      LEFT JOIN tbm_bod AS a5 ON(a5.co_emp=x2.coEmpTra and a5.co_bod=x2.bod2 )

) AS x3
 LEFT JOIN tbm_detmovinv as a2 ON(a2.co_emp=x3.coEmpTra AND a2.co_loc=x3.coLocTra AND a2.co_tipdoc=x3.coTipDocTra AND a2.co_doc=x3.coDocTra AND a2.nd_can>0)
 INNER JOIN tbm_inv AS inv ON(inv.co_emp=a2.co_emp AND inv.co_itm=a2.co_itm)
 ORDER BY a2.co_reg]]>
	</queryString>
