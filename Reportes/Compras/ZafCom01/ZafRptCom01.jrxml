	<parameter name="codCot" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\Zafiro_escritorio\\Reportes\\Compras\\ZafCom01\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select a.co_emp, a.co_loc, a.co_cot, a.fe_cot, a.tx_ate, a.nd_sub, a.nd_valiva, a.nd_tot,
a.tx_obs1, a2.tx_nom as nomcom, a3.tx_des as nomforpag,
a1.tx_ide, a1.co_cli, a1.tx_nom, a1.tx_dir, a1.tx_tel
from tbm_cabcotcom as a
inner join tbm_cli as a1 on (a1.co_emp=a.co_emp and a1.co_cli=a.co_prv)
inner join tbm_usr as a2 on (a2.co_usr=a.co_com )
inner join tbm_cabforpag as a3 on (a3.co_emp=a.co_emp  and a3.co_forpag=a.co_forpag )
where a.co_emp=$P{codEmp}
and a.co_loc=$P{codLoc}
and a.co_cot=$P{codCot}]]>
	</queryString>
