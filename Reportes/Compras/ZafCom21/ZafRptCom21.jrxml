	<parameter name="strCamAudRpt" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[Campos de auditoria.
	strNomCla + strNomRpt + strUsr + strFecHorImp
strNomCla: Nombre de la clase desde la que se invoca al reporte
strNomRpt: Nombre del reporte
strUsr: Usuario que genera el reporte
strFecHorImp: Fecha y hora de impresión]]></parameterDescription>
	</parameter>
	<parameter name="co_usr" class="java.lang.Short">
		<parameterDescription><![CDATA[Código del usuario]]></parameterDescription>
		<defaultValueExpression><![CDATA[Short.valueOf("1")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT a1.co_emp, a2.tx_nom AS tx_nomEmp, a1.co_loc, a3.tx_nom AS tx_nomLoc, a1.co_tipDoc, a4.tx_desCor, a4.tx_desLar
, a1.co_doc, a1.fe_doc, a1.ne_numDoc
FROM tbm_cabMovInv AS a1
INNER JOIN tbm_emp AS a2 ON (a1.co_emp=a2.co_emp)
INNER JOIN tbm_loc AS a3 ON (a1.co_emp=a3.co_emp AND a1.co_loc=a3.co_loc)
INNER JOIN tbm_cabTipDoc AS a4 ON (a1.co_emp=a4.co_emp AND a1.co_loc=a4.co_loc AND a1.co_tipDoc=a4.co_tipDoc)
WHERE a1.co_emp=$P{co_emp} AND a1.co_loc=$P{co_loc} AND a1.co_tipDoc=$P{co_tipDoc} AND a1.co_doc=$P{co_doc}
ORDER BY a1.co_emp, a1.co_loc, a1.co_tipDoc, a1.ne_numDoc]]>
	</queryString>
